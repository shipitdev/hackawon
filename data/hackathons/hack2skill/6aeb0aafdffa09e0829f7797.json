            "description": "<div id=\"ih-ps\">\n<style>\n@import url(\"https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap\");\n\n#ih-ps {\n  --blue:#0070c0;\n  --blue-hi:#1a8ae0;\n  --blue-glow:#3aa6f5;\n  --orange:#dc8435;\n  --orange-hi:#f29a4a;\n  --char:#474747;\n  --grey:#f1f2f2;\n  --ink:#0b0d10;\n  --muted:#5f6670;\n  --line:#e3e6ea;\n  --grad:linear-gradient(90deg,#1a8ae0 0%,#dc8435 100%);\n  --grad-d:linear-gradient(135deg,#0070c0 0%,#dc8435 100%);\n  --grad-v:linear-gradient(180deg,#1a8ae0 0%,#dc8435 100%);\n  display:block;\n  width:100%;\n  text-align:left;\n  letter-spacing:normal;\n  font-family:\"League Spartan\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n  font-weight:400;\n  line-height:1.55;\n  color:var(--char);\n  background:#fff;\n  -webkit-font-smoothing:antialiased;\n}\n\n#ih-ps, #ih-ps * {\n  box-sizing:border-box;\n  font-family:\"League Spartan\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n}\n\n#ih-ps h2, #ih-ps h3, #ih-ps h4, #ih-ps p,\n#ih-ps ul, #ih-ps ol, #ih-ps li {\n  margin:0;\n  padding:0;\n  text-transform:none;\n  text-shadow:none;\n  letter-spacing:normal;\n}\n\n#ih-ps ul, #ih-ps ol { list-style:none; }\n#ih-ps li::marker { content:\"\"; }\n#ih-ps svg { display:block; }\n#ih-ps img { display:block; max-width:100%; border:0; }\n#ih-ps a { color:inherit; text-decoration:none; }\n\n#ih-ps a:focus-visible,\n#ih-ps summary:focus-visible {\n  outline:3px solid var(--orange);\n  outline-offset:3px;\n}\n\n#ih-ps .wrap {\n  position:relative;\n  z-index:1;\n  max-width:1180px;\n  margin:0 auto;\n  padding:0 24px;\n  container-type:inline-size;\n}\n\n#ih-ps h2, #ih-ps h3, #ih-ps h4, #ih-ps p,\n#ih-ps li, #ih-ps span, #ih-ps b,\n#ih-ps small, #ih-ps a, #ih-ps summary {\n  overflow-wrap:break-word;\n}\n\n#ih-ps .sec {\n  position:relative;\n  overflow:hidden;\n  padding:64px 0 68px;\n}\n\n#ih-ps .light { background:#ffffff; }\n\n#ih-ps .light::before {\n  content:\"\";\n  position:absolute;\n  inset:0;\n  pointer-events:none;\n  background:\n    radial-gradient(780px 540px at 0% 0%, rgba(0,112,192,.30), rgba(0,112,192,.08) 45%, transparent 72%),\n    radial-gradient(600px 480px at 100% 40%, rgba(220,132,53,.16), transparent 70%),\n    radial-gradient(720px 520px at 100% 100%, rgba(220,132,53,.34), rgba(220,132,53,.08) 45%, transparent 72%),\n    radial-gradient(620px 440px at 0% 100%, rgba(0,112,192,.16), transparent 70%),\n    linear-gradient(135deg, rgba(0,112,192,.05) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%, rgba(220,132,53,.06) 100%);\n}\n\n#ih-ps .light::after {\n  content:\"\";\n  position:absolute;\n  left:-15%;\n  right:-15%;\n  bottom:0;\n  height:360px;\n  pointer-events:none;\n  background-image:\n    linear-gradient(rgba(0,96,170,.17) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0,96,170,.17) 1px, transparent 1px);\n  background-size:58px 58px;\n  transform:perspective(440px) rotateX(64deg);\n  transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 35%,transparent 85%);\n  mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 35%,transparent 85%);\n}\n\n#ih-ps .dark {\n  background:#04070c;\n  color:#c9d1db;\n}\n\n#ih-ps .dark::before {\n  content:\"\";\n  position:absolute;\n  inset:0;\n  pointer-events:none;\n  background:\n    radial-gradient(ellipse 45% 60% at 0% 0%, rgba(0,112,192,.55), transparent 70%),\n    radial-gradient(ellipse 40% 55% at 100% 100%, rgba(220,132,53,.45), transparent 70%);\n}\n\n#ih-ps .dark::after {\n  content:\"\";\n  position:absolute;\n  left:-15%;\n  right:-15%;\n  bottom:0;\n  height:320px;\n  pointer-events:none;\n  background-image:\n    linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);\n  background-size:52px 52px;\n  transform:perspective(420px) rotateX(64deg);\n  transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 0%,transparent 85%);\n  mask-image:linear-gradient(to top,#000 0%,transparent 85%);\n}\n\n#ih-ps .eyebrow {\n  display:inline-flex;\n  align-items:center;\n  gap:10px;\n  padding:7px 15px 5px;\n  border-radius:999px;\n  font-size:.78rem;\n  font-weight:600;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n}\n\n#ih-ps .eyebrow i {\n  width:8px;\n  height:8px;\n  border-radius:50%;\n  background:var(--orange);\n  box-shadow:0 0 0 4px rgba(220,132,53,.2);\n}\n\n#ih-ps .light .eyebrow {\n  color:var(--blue);\n  background:#e7f2fb;\n  border:1px solid #cbe2f5;\n}\n\n#ih-ps .dark .eyebrow {\n  color:#fff;\n  background:rgba(255,255,255,.08);\n  border:1px solid rgba(255,255,255,.2);\n}\n\n#ih-ps .h2 {\n  margin-top:16px;\n  font-size:clamp(2rem,4.4vw,3.15rem);\n  line-height:1.04;\n  font-weight:500;\n  letter-spacing:-.02em;\n  color:var(--ink);\n}\n\n#ih-ps .dark .h2 { color:#fff; }\n\n#ih-ps .h2 em {\n  font-style:normal;\n  color:var(--blue);\n}\n\n#ih-ps .dark .h2 em { color:var(--orange-hi); }\n\n@supports ((-webkit-background-clip:text) or (background-clip:text)) {\n  #ih-ps .h2 em {\n    background:var(--grad);\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n  }\n\n  #ih-ps .dark .h2 em {\n    background:linear-gradient(90deg,#3aa6f5,#f29a4a);\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n  }\n}\n\n#ih-ps .lead {\n  margin-top:14px;\n  max-width:62ch;\n  font-size:1.1rem;\n  line-height:1.6;\n}\n\n#ih-ps .light .lead { color:var(--char); }\n#ih-ps .dark .lead { color:#c9d1db; }\n\n#ih-ps .h2s-logo {\n  height:30px;\n  width:auto;\n}\n\n#ih-ps .h2s-text {\n  display:inline-flex;\n  align-items:center;\n  height:30px;\n  font-size:1.6rem;\n  font-weight:700;\n  letter-spacing:-.02em;\n  line-height:1;\n  padding-top:4px;\n}\n\n@media (max-width:560px) {\n  #ih-ps .sec { padding:56px 0 60px; }\n  #ih-ps .wrap { padding:0 18px; }\n}\n\n#ih-ps .head {\n  display:flex;\n  flex-wrap:wrap;\n  align-items:flex-end;\n  justify-content:space-between;\n  gap:12px 28px;\n}\n\n#ih-ps .head .lead {\n  margin-top:10px;\n  max-width:50ch;\n}\n\n#ih-ps .prep {\n  display:flex;\n  flex-wrap:wrap;\n  gap:8px;\n  margin-top:20px;\n}\n\n#ih-ps .prep li {\n  display:inline-flex;\n  align-items:center;\n  gap:8px;\n  padding:6px 14px 4px 6px;\n  border-radius:999px;\n  font-size:.88rem;\n  color:var(--ink);\n  background:rgba(255,255,255,.9);\n  border:1px solid var(--line);\n  box-shadow:0 4px 12px rgba(0,40,80,.05);\n}\n\n#ih-ps .prep i {\n  width:24px;\n  height:24px;\n  border-radius:50%;\n  display:grid;\n  place-items:center;\n  font-style:normal;\n  font-size:.66rem;\n  font-weight:700;\n  color:#fff;\n  padding-top:2px;\n}\n\n#ih-ps .prep li:nth-child(1) i { background:var(--blue); }\n#ih-ps .prep li:nth-child(2) i { background:var(--char); }\n#ih-ps .prep li:nth-child(3) i { background:var(--orange); }\n\n/* Track tabs */\n#ih-ps .tabs { margin-top:26px; }\n\n#ih-ps .tabs > input {\n  position:absolute;\n  opacity:0;\n  width:1px;\n  height:1px;\n  pointer-events:none;\n}\n\n#ih-ps .tabbar {\n  display:none;\n  gap:12px;\n  margin-bottom:16px;\n}\n\n#ih-ps .tabs:has(> input) .tabbar {\n  display:grid;\n  grid-template-columns:repeat(2,minmax(0,1fr));\n}\n\n#ih-ps .tab {\n  display:flex;\n  align-items:center;\n  gap:14px;\n  padding:12px 16px;\n  border-radius:20px;\n  cursor:pointer;\n  background:#fff;\n  border:1.5px solid var(--line);\n  box-shadow:0 6px 18px rgba(0,40,80,.06);\n  transition:transform .25s ease, box-shadow .25s ease, background .25s ease;\n}\n\n#ih-ps .tab:hover { transform:translateY(-2px); }\n\n#ih-ps .tn {\n  font-size:2.1rem;\n  line-height:1;\n  font-weight:700;\n  letter-spacing:-.04em;\n  color:#d5dce3;\n}\n\n#ih-ps .tab small {\n  display:block;\n  font-size:.66rem;\n  font-weight:700;\n  letter-spacing:.14em;\n  text-transform:uppercase;\n  color:var(--muted);\n}\n\n#ih-ps .tab b {\n  display:block;\n  margin-top:2px;\n  font-size:1.1rem;\n  font-weight:600;\n  line-height:1.15;\n  color:var(--ink);\n}\n\n#ih-ps .tabs > input:focus-visible + input + .tabbar .tab1,\n#ih-ps .tabs > input + input:focus-visible + .tabbar .tab2 {\n  outline:3px solid var(--orange);\n  outline-offset:3px;\n}\n\n#ih-ps .tabs > input:checked + input + .tabbar .tab1 {\n  background:linear-gradient(135deg,#2a9af0,#0062ad);\n  border-color:transparent;\n  box-shadow:0 14px 32px rgba(0,112,192,.32);\n}\n\n#ih-ps .tabs > input + input:checked + .tabbar .tab2 {\n  background:linear-gradient(135deg,#f7ad66,#c4651c);\n  border-color:transparent;\n  box-shadow:0 14px 32px rgba(220,132,53,.34);\n}\n\n#ih-ps .tabs > input:checked + input + .tabbar .tab1 :is(small,b),\n#ih-ps .tabs > input + input:checked + .tabbar .tab2 :is(small,b) {\n  color:#fff;\n}\n\n#ih-ps .tabs > input:checked + input + .tabbar .tab1 .tn,\n#ih-ps .tabs > input + input:checked + .tabbar .tab2 .tn {\n  color:rgba(255,255,255,.55);\n}\n\n#ih-ps .panel + .panel { margin-top:16px; }\n#ih-ps .tabs:has(> input) .panel + .panel { margin-top:0; }\n\n#ih-ps .tabs:has(> input:first-child:checked) .pan2 { display:none; }\n#ih-ps .tabs:has(> input:nth-child(2):checked) .pan1 { display:none; }\n\n#ih-ps .panel { animation:X-fade .4s ease; }\n\n@keyframes X-fade {\n  from { opacity:0; transform:translateY(8px); }\n  to { opacity:1; transform:none; }\n}\n\n/* Scrollable track panels */\n#ih-ps .panel {\n  position:relative;\n  max-height:560px;\n  overflow-y:auto;\n  overflow-x:hidden;\n  padding:12px 12px 0;\n  border-radius:26px;\n  background:rgba(255,255,255,.55);\n  border:1px solid var(--line);\n  box-shadow:inset 0 1px 0 #fff, 0 12px 30px rgba(0,40,80,.06);\n  scrollbar-width:thin;\n  scroll-behavior:smooth;\n  -webkit-overflow-scrolling:touch;\n}\n\n#ih-ps .pan1 { scrollbar-color:#0070c0 rgba(0,112,192,.1); }\n#ih-ps .pan2 { scrollbar-color:#dc8435 rgba(220,132,53,.12); }\n\n#ih-ps .panel::-webkit-scrollbar { width:8px; }\n\n#ih-ps .panel::-webkit-scrollbar-track {\n  margin:18px 0;\n  border-radius:8px;\n  background:rgba(0,40,80,.06);\n}\n\n#ih-ps .pan1::-webkit-scrollbar-thumb {\n  border-radius:8px;\n  background:#0070c0;\n}\n\n#ih-ps .pan2::-webkit-scrollbar-thumb {\n  border-radius:8px;\n  background:#dc8435;\n}\n\n#ih-ps .panel:focus-visible {\n  outline:3px solid var(--orange);\n  outline-offset:3px;\n}\n\n#ih-ps .panel::after {\n  content:\"\";\n  position:sticky;\n  bottom:0;\n  display:block;\n  height:44px;\n  margin:-30px -12px 0;\n  pointer-events:none;\n  background:linear-gradient(to bottom, rgba(247,250,253,0), rgba(247,250,253,.96) 75%);\n}\n\n#ih-ps .hint {\n  display:flex;\n  align-items:center;\n  justify-content:flex-end;\n  gap:6px;\n  margin:-4px 4px 10px;\n  font-size:.78rem;\n  font-weight:600;\n  letter-spacing:.04em;\n  color:var(--muted);\n}\n\n#ih-ps .hint svg {\n  width:14px;\n  height:14px;\n  fill:none;\n  stroke:currentColor;\n  stroke-width:2;\n  stroke-linecap:round;\n  stroke-linejoin:round;\n}\n\n#ih-ps .panel .foot { margin-bottom:12px; }\n\n@container (max-width:520px) {\n  #ih-ps .panel {\n    max-height:520px;\n    padding:8px 8px 0;\n    border-radius:22px;\n  }\n\n  #ih-ps .panel::after { margin:-30px -8px 0; }\n  #ih-ps .hint { justify-content:flex-start; }\n}\n\n/* Hero section */\n#ih-ps .hero {\n  position:relative;\n  isolation:isolate;\n  overflow:hidden;\n  display:grid;\n  grid-template-columns:minmax(0,1fr);\n  gap:18px;\n  padding:26px;\n  border-radius:24px;\n  color:#fff;\n}\n\n#ih-ps .pan1 .hero {\n  background:\n    radial-gradient(ellipse 70% 90% at 100% 100%, rgba(26,138,224,.85), transparent 70%),\n    linear-gradient(160deg,#000 0%,#021a30 45%,#0070c0 100%);\n  box-shadow:0 20px 44px rgba(0,60,120,.3);\n}\n\n#ih-ps .pan2 .hero {\n  background:\n    radial-gradient(ellipse 70% 90% at 100% 100%, rgba(242,154,74,.85), transparent 70%),\n    linear-gradient(160deg,#000 0%,#2a1606 45%,#dc8435 100%);\n  box-shadow:0 20px 44px rgba(140,70,20,.3);\n}\n\n#ih-ps .hero::after {\n  content:\"\";\n  position:absolute;\n  left:0;\n  right:0;\n  bottom:0;\n  height:70%;\n  z-index:-1;\n  background-image:\n    linear-gradient(rgba(255,255,255,.14) 1px,transparent 1px),\n    linear-gradient(90deg,rgba(255,255,255,.14) 1px,transparent 1px);\n  background-size:30px 30px;\n  transform:perspective(260px) rotateX(60deg);\n  transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 5%,transparent 85%);\n  mask-image:linear-gradient(to top,#000 5%,transparent 85%);\n}\n\n#ih-ps .ht {\n  display:flex;\n  align-items:center;\n  gap:12px;\n}\n\n#ih-ps .num {\n  font-size:3rem;\n  line-height:.9;\n  font-weight:700;\n  letter-spacing:-.05em;\n  color:transparent;\n  -webkit-text-stroke:1.5px rgba(255,255,255,.6);\n}\n\n#ih-ps .hero h3 {\n  font-size:clamp(1.35rem,2.6vw,1.8rem);\n  line-height:1.1;\n  font-weight:700;\n  letter-spacing:-.01em;\n  color:#fff;\n}\n\n#ih-ps .stmt {\n  margin-top:16px;\n  padding-left:14px;\n  border-left:3px solid;\n  font-size:1.02rem;\n  line-height:1.6;\n  font-weight:500;\n  color:#fff;\n}\n\n#ih-ps .sl {\n  display:block;\n  margin-top:16px;\n  font-size:.64rem;\n  font-weight:700;\n  letter-spacing:.14em;\n  text-transform:uppercase;\n  color:rgba(255,255,255,.75);\n}\n\n#ih-ps .sl + .stmt { margin-top:6px; }\n#ih-ps .pan1 .stmt { border-color:#5bb6f7; }\n#ih-ps .pan2 .stmt { border-color:#f7ad66; }\n\n#ih-ps .hard {\n  align-self:center;\n  padding:16px 18px;\n  border-radius:16px;\n  background:rgba(255,255,255,.08);\n  border:1px solid rgba(255,255,255,.26);\n  backdrop-filter:blur(6px);\n}\n\n#ih-ps .gh {\n  display:inline-flex;\n  align-items:center;\n  gap:8px;\n  font-size:.66rem;\n  font-weight:700;\n  letter-spacing:.14em;\n  text-transform:uppercase;\n  color:#fff;\n}\n\n#ih-ps .gh::before {\n  content:\"?\";\n  width:18px;\n  height:18px;\n  border-radius:50%;\n  display:grid;\n  place-items:center;\n  font-size:.7rem;\n  padding-top:2px;\n  color:#05080d;\n  background:#fff;\n}\n\n#ih-ps .hard p {\n  margin-top:8px;\n  font-size:1.08rem;\n  line-height:1.45;\n  font-weight:500;\n  color:#fff;\n}\n\n#ih-ps .simple {\n  margin-top:14px;\n  padding:10px 14px;\n  border-radius:14px;\n  font-size:.95rem;\n  line-height:1.45;\n  color:var(--ink);\n  background:rgba(255,255,255,.9);\n  border:1px dashed;\n}\n\n#ih-ps .pan1 .simple { border-color:#9cc8ea; }\n#ih-ps .pan2 .simple { border-color:#efc29b; }\n\n#ih-ps .simple b { font-weight:700; }\n#ih-ps .pan1 .simple b { color:var(--blue); }\n#ih-ps .pan2 .simple b { color:#c06a1f; }\n\n/* Cards */\n#ih-ps .cards {\n  display:grid;\n  grid-template-columns:minmax(0,1fr);\n  gap:14px;\n  margin-top:14px;\n}\n\n#ih-ps .foot {\n  display:grid;\n  grid-template-columns:minmax(0,1fr);\n  gap:14px;\n  margin-top:14px;\n}\n\n#ih-ps .foot .card {\n  display:flex;\n  flex-direction:column;\n}\n\n#ih-ps .help {\n  margin-top:10px;\n  font-size:.84rem;\n  line-height:1.45;\n  color:var(--muted);\n}\n\n#ih-ps .card {\n  min-width:0;\n  padding:18px 20px;\n  border-radius:20px;\n  background:rgba(255,255,255,.93);\n  border:1px solid var(--line);\n  box-shadow:0 10px 26px rgba(0,40,80,.06);\n  backdrop-filter:blur(8px);\n}\n\n#ih-ps .ch {\n  display:flex;\n  align-items:center;\n  gap:10px;\n}\n\n#ih-ps .ci {\n  width:32px;\n  height:32px;\n  flex:none;\n  border-radius:10px;\n  display:grid;\n  place-items:center;\n}\n\n#ih-ps .ci svg {\n  width:17px;\n  height:17px;\n  fill:none;\n  stroke:#fff;\n  stroke-width:2;\n  stroke-linecap:round;\n  stroke-linejoin:round;\n}\n\n#ih-ps .ci:empty { display:none; }\n\n#ih-ps .pan1 .ci {\n  background:linear-gradient(145deg,#2a9af0,#0062ad);\n}\n\n#ih-ps .pan2 .ci {\n  background:linear-gradient(145deg,#f7ad66,#c96f22);\n}\n\n#ih-ps .card h4 {\n  font-size:1.02rem;\n  font-weight:700;\n  line-height:1.2;\n  color:var(--ink);\n}\n\n#ih-ps .ck {\n  display:grid;\n  gap:7px;\n  margin-top:12px;\n}\n\n#ih-ps .ck li {\n  display:grid;\n  grid-template-columns:auto 1fr;\n  gap:8px;\n  align-items:start;\n  font-size:.92rem;\n  line-height:1.4;\n  color:var(--ink);\n}\n\n#ih-ps .ck svg {\n  width:16px;\n  height:16px;\n  margin-top:1px;\n  fill:none;\n  stroke-width:2.6;\n  stroke-linecap:round;\n  stroke-linejoin:round;\n}\n\n#ih-ps .pan1 .ck svg { stroke:var(--blue); }\n#ih-ps .pan2 .ck svg { stroke:var(--orange); }\n\n#ih-ps .exm {\n  margin-top:10px;\n  padding:10px 12px;\n  border-radius:12px;\n  font-size:.9rem;\n  line-height:1.45;\n  color:var(--ink);\n}\n\n#ih-ps .pan1 .exm {\n  background:#eef6fd;\n  border-left:4px solid var(--blue);\n}\n\n#ih-ps .pan2 .exm {\n  background:#fdf3ea;\n  border-left:4px solid var(--orange);\n}\n\n#ih-ps .lbl {\n  display:block;\n  margin-top:0;\n  font-size:.64rem;\n  font-weight:700;\n  letter-spacing:.14em;\n  text-transform:uppercase;\n  color:var(--muted);\n}\n\n#ih-ps .tags {\n  display:flex;\n  flex-wrap:wrap;\n  gap:6px;\n  margin-top:8px;\n}\n\n#ih-ps .tags li {\n  padding:4px 10px 2px;\n  border-radius:999px;\n  font-size:.8rem;\n  color:var(--ink);\n}\n\n#ih-ps .pan1 .tags li {\n  background:#eef6fd;\n  border:1px solid #d3e7f7;\n}\n\n#ih-ps .pan2 .tags li {\n  background:#fdf3ea;\n  border:1px solid #f5dcc3;\n}\n\n@container (min-width:760px) {\n  #ih-ps .hero {\n    grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);\n    gap:28px;\n    padding:28px 30px;\n  }\n\n  #ih-ps .cards {\n    grid-template-columns:repeat(3,minmax(0,1fr));\n  }\n\n  #ih-ps .foot {\n    grid-template-columns:minmax(0,1fr) minmax(0,1fr);\n  }\n}\n\n@container (max-width:520px) {\n  #ih-ps .tab { padding:10px 12px; gap:8px; }\n  #ih-ps .tn { font-size:1.5rem; }\n  #ih-ps .tab b { font-size:.95rem; }\n  #ih-ps .hero { padding:20px 18px; }\n  #ih-ps .card { padding:16px; }\n  #ih-ps .num { font-size:2.3rem; }\n}\n\n@media (prefers-reduced-motion:reduce) {\n  #ih-ps .panel { animation:none; }\n  #ih-ps .tab { transition:none; }\n  #ih-ps .tab:hover { transform:none; }\n}\n</style>\n\n<section class=\"sec light\" aria-labelledby=\"ih-ps-title\">\n  <div class=\"wrap\">\n\n    <div class=\"head\">\n      <div>\n        <span class=\"eyebrow\">\n          <i aria-hidden=\"true\"></i>\n          Two challenge tracks\n        </span>\n\n        <h2 class=\"h2\" id=\"ih-ps-title\">\n          Technical Challenge <em>Areas</em>\n        </h2>\n      </div>\n\n      <p class=\"lead\">\n        Pick one track and build a reusable pipeline that tests what frontier AI can really do.\n      </p>\n    </div>\n\n    <ul class=\"prep\" aria-label=\"Before you start\">\n      <li><i>✓</i>Working, repeatable prototype</li>\n      <li><i>&lt;/&gt;</i>Any language, Claude Code &amp; model APIs provided</li>\n      <li><i>↑</i>Code, samples, evidence &amp; demo</li>\n    </ul>\n\n    <div class=\"tabs\">\n\n      <input type=\"radio\" name=\"ih-ps-track\" id=\"ih-ps-r1\" checked>\n      <input type=\"radio\" name=\"ih-ps-track\" id=\"ih-ps-r2\">\n\n      <div class=\"tabbar\">\n        <label class=\"tab tab1\" for=\"ih-ps-r1\">\n          <span class=\"tn\">01</span>\n          <span>\n            <small>Track 1</small>\n            <b>Coding Task Factory</b>\n          </span>\n        </label>\n\n        <label class=\"tab tab2\" for=\"ih-ps-r2\">\n          <span class=\"tn\">02</span>\n          <span>\n            <small>Track 2</small>\n            <b>Visual Task Factory</b>\n          </span>\n        </label>\n      </div>\n\n      <p class=\"hint\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M12 4v16M8 8l4-4 4 4M8 16l4 4 4-4\"/>\n        </svg>\n        Scroll inside the box to read the full track\n      </p>\n\n      <!-- TRACK 1 -->\n      <div class=\"panel pan1\" tabindex=\"0\" role=\"region\" aria-labelledby=\"ih-ps-t1\">\n\n        <div class=\"hero\">\n          <div>\n            <div class=\"ht\">\n              <span class=\"num\" aria-hidden=\"true\">01</span>\n              <h3 id=\"ih-ps-t1\">Track 1 — Coding Task Factory</h3>\n            </div>\n\n            <span class=\"sl\">Problem statement</span>\n\n            <p class=\"stmt\">\n              Using a supplied working software repository and\n              <a href=\"https://www.harborframework.com/\" target=\"_blank\" rel=\"noopener noreferrer\">task interface</a>,\n              your team will build one reusable strategy for generating realistic feature-development tasks suitable for evaluating AI coding systems.\n\n              Each task package should contain clear, achievable requirements,\n              a reference implementation, and tests that verify the new feature\n              while protecting existing functionality.\n\n              Packages must identify their starting repository version and\n              follow the supplied task interface.\n\n              Reference implementations and tests must work with the repository's\n              language, framework, dependencies, and execution environment.\n\n              Validation evidence should show that implementations satisfy the\n              requirements, feature tests detect missing or incorrect behavior,\n              and regression checks protect existing functionality.\n            </p>\n          </div>\n\n          <div class=\"hard\">\n            <span class=\"gh\">The big question</span>\n            <p>\n              How can we automatically create realistic software-development\n              tasks that are clear, solvable, and reliably testable?\n            </p>\n          </div>\n        </div>\n\n        <p class=\"simple\">\n          <b>In short:</b>\n          turn a real codebase into new, testable coding tasks that fairly\n          challenge AI coding systems.\n        </p>\n\n        <div class=\"cards\">\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/>\n                </svg>\n              </span>\n              <h4>What you’ll build</h4>\n            </div>\n\n            <ul class=\"ck\">\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Clear, achievable requirements for a new feature</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>A reference implementation that runs in the repo’s stack</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Feature tests plus regression checks for existing code</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Packages tagged to their starting repo version</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8z\"/>\n                </svg>\n              </span>\n              <h4>How to stand out</h4>\n            </div>\n\n            <ul class=\"ck\">\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Prove each implementation meets its requirements</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Show tests catch missing or incorrect behaviour</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Vary behaviour, rules or interactions, not just names</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Meaningful variation beats a high task count</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3\"/>\n                </svg>\n              </span>\n              <h4>What you’ll submit</h4>\n            </div>\n\n            <ul class=\"ck\">\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>A reusable task-generation pipeline</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Sample task packages</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Validation evidence: tests, runs and results</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>A live demo generating and validating a package</span>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n\n        <div class=\"foot\">\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.6 1 2.5h6c0-.9.2-1.7 1-2.5A6 6 0 0 0 12 3z\"/>\n                </svg>\n              </span>\n              <h4>Example</h4>\n            </div>\n\n            <p class=\"exm\">\n              A shopping-cart app gets a generated task to add discount codes\n              with eligibility rules and spending thresholds, plus tests that\n              prove it works.\n            </p>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <circle cx=\"12\" cy=\"8\" r=\"4\"/>\n                  <path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"/>\n                </svg>\n              </span>\n              <h4>Great fit if you enjoy</h4>\n            </div>\n\n            <ul class=\"tags\">\n              <li>Extending existing codebases</li>\n              <li>Automating with model APIs</li>\n              <li>Writing testable requirements</li>\n              <li>Testing &amp; debugging</li>\n              <li>Evaluating AI coding systems</li>\n            </ul>\n\n            <p class=\"help\">\n              Code-generation or AI-evaluation experience helps,\n              but strong programming fundamentals matter most.\n            </p>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- TRACK 2 -->\n      <div class=\"panel pan2\" tabindex=\"0\" role=\"region\" aria-labelledby=\"ih-ps-t2\">\n\n        <div class=\"hero\">\n          <div>\n            <div class=\"ht\">\n              <span class=\"num\" aria-hidden=\"true\">02</span>\n              <h3 id=\"ih-ps-t2\">Track 2 — Visual Task Factory</h3>\n            </div>\n\n            <span class=\"sl\">Problem statement</span>\n\n            <p class=\"stmt\">\n              Your team will choose an image family and visual-understanding\n              problem with meaningful practical impact.\n\n              Build an automated pipeline that generates synthetic images,\n              questions about those images, and verifiable reference answers.\n\n              Explain the application your chosen problem supports, why errors\n              matter, and how your synthetic examples represent its visual\n              challenges.\n\n              Teams choose their image family, application domain, and\n              generation approach.\n\n              Each task must require visual understanding, provide sufficient\n              image evidence to answer the question, and include a reliable\n              method for checking the answer.\n\n              Explain how reference answers are established and validated\n              independently of the model being evaluated.\n\n              Use the generated tasks to evaluate frontier multimodal models\n              and investigate their strengths and weaknesses.\n            </p>\n          </div>\n\n          <div class=\"hard\">\n            <span class=\"gh\">The big question</span>\n            <p>\n              Which visual capabilities matter most in real-world applications,\n              and how can we reliably test whether frontier AI models possess them?\n            </p>\n          </div>\n        </div>\n\n        <p class=\"simple\">\n          <b>In short:</b>\n          create images and questions with answers you already know,\n          then test how well top AI models really “see”.\n        </p>\n\n        <div class=\"cards\">\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/>\n                </svg>\n              </span>\n              <h4>What you’ll build</h4>\n            </div>\n\n            <ul class=\"ck\">\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Pick an image family and a real-world visual problem</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Generate synthetic images and questions about them</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Reference answers checked without the tested model</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>An evaluation of frontier multimodal models</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8z\"/>\n                </svg>\n              </span>\n              <h4>How to stand out</h4>\n            </div>\n\n            <ul class=\"ck\">\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Every question needs genuine visual understanding</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Each image holds enough evidence to answer</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Vary visual relationships and reasoning, not just count</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Explain why errors matter in the real application</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3\"/>\n                </svg>\n              </span>\n              <h4>What you’ll submit</h4>\n            </div>\n\n            <ul class=\"ck\">\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>A reusable generation and evaluation pipeline</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Sample tasks with validation evidence</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>Findings on model strengths and weaknesses</span>\n              </li>\n              <li>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n                <span>A demo where scoring separates right from wrong</span>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n\n        <div class=\"foot\">\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.6 1 2.5h6c0-.9.2-1.7 1-2.5A6 6 0 0 0 12 3z\"/>\n                </svg>\n              </span>\n              <h4>Example</h4>\n            </div>\n\n            <p class=\"exm\">\n              Your code draws a bar chart, so it already knows which bar is\n              tallest and can check every model’s answer.\n            </p>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"ch\">\n              <span class=\"ci\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <circle cx=\"12\" cy=\"8\" r=\"4\"/>\n                  <path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"/>\n                </svg>\n              </span>\n              <h4>Great fit if you enjoy</h4>\n            </div>\n\n            <ul class=\"tags\">\n              <li>Multimodal LLM APIs</li>\n              <li>Image generation</li>\n              <li>Structured data</li>\n              <li>Logic, algorithms &amp; testing</li>\n              <li>Designing experiments</li>\n            </ul>\n\n            <p class=\"help\">\n              Experience with computer vision or synthetic data helps,\n              but curiosity and careful reasoning matter most.\n            </p>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n</div>",
