            "description": "<div id=\"ih-ps\">\n<style>\n@import url(\"https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap\");\n#ih-ps {\n  --blue:#0070c0; --blue-hi:#1a8ae0; --blue-glow:#3aa6f5; --orange:#dc8435; --orange-hi:#f29a4a;\n  --char:#474747; --grey:#f1f2f2; --ink:#0b0d10; --muted:#5f6670; --line:#e3e6ea;\n  --grad:linear-gradient(90deg,#1a8ae0 0%,#dc8435 100%);\n  --grad-d:linear-gradient(135deg,#0070c0 0%,#dc8435 100%);\n  --grad-v:linear-gradient(180deg,#1a8ae0 0%,#dc8435 100%);\n  display:block; width:100%; text-align:left; letter-spacing:normal;\n  font-family:\"League Spartan\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n  font-weight:400; line-height:1.55; color:var(--char); background:#fff;\n  -webkit-font-smoothing:antialiased;\n}\n#ih-ps, #ih-ps * { box-sizing:border-box; font-family:\"League Spartan\",\"Helvetica Neue\",Helvetica,Arial,sans-serif; }\n#ih-ps h2, #ih-ps h3, #ih-ps h4, #ih-ps p, #ih-ps ul, #ih-ps ol, #ih-ps li { margin:0; padding:0; text-transform:none; text-shadow:none; letter-spacing:normal; }\n#ih-ps ul, #ih-ps ol { list-style:none; }\n#ih-ps li::marker { content:\"\"; }\n#ih-ps svg { display:block; }\n#ih-ps img { display:block; max-width:100%; border:0; }\n#ih-ps a { color:inherit; text-decoration:none; }\n#ih-ps a:focus-visible, #ih-ps summary:focus-visible { outline:3px solid var(--orange); outline-offset:3px; }\n#ih-ps .wrap { position:relative; z-index:1; max-width:1180px; margin:0 auto; padding:0 24px; }\n#ih-ps .wrap { container-type:inline-size; }\n#ih-ps h2, #ih-ps h3, #ih-ps h4, #ih-ps p, #ih-ps li, #ih-ps span, #ih-ps b, #ih-ps small, #ih-ps a, #ih-ps summary { overflow-wrap:break-word; }\n#ih-ps .sec { position:relative; overflow:hidden; padding:80px 0 84px; }\n#ih-ps .light { background:#ffffff; }\n#ih-ps .light::before { content:\"\"; position:absolute; inset:0; pointer-events:none;\n  background:\n    radial-gradient(780px 540px at 0% 0%, rgba(0,112,192,.30), rgba(0,112,192,.08) 45%, transparent 72%),\n    radial-gradient(600px 480px at 100% 40%, rgba(220,132,53,.16), transparent 70%),\n    radial-gradient(720px 520px at 100% 100%, rgba(220,132,53,.34), rgba(220,132,53,.08) 45%, transparent 72%),\n    radial-gradient(620px 440px at 0% 100%, rgba(0,112,192,.16), transparent 70%),\n    linear-gradient(135deg, rgba(0,112,192,.05) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%, rgba(220,132,53,.06) 100%); }\n#ih-ps .light::after { content:\"\"; position:absolute; left:-15%; right:-15%; bottom:0; height:360px; pointer-events:none;\n  background-image:linear-gradient(rgba(0,96,170,.17) 1px, transparent 1px), linear-gradient(90deg, rgba(0,96,170,.17) 1px, transparent 1px);\n  background-size:58px 58px; transform:perspective(440px) rotateX(64deg); transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 35%,transparent 85%); mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 35%,transparent 85%); }\n#ih-ps .dark { background:#04070c; color:#c9d1db; }\n#ih-ps .dark::before { content:\"\"; position:absolute; inset:0; pointer-events:none;\n  background:\n    radial-gradient(ellipse 45% 60% at 0% 0%, rgba(0,112,192,.55), transparent 70%),\n    radial-gradient(ellipse 40% 55% at 100% 100%, rgba(220,132,53,.45), transparent 70%); }\n#ih-ps .dark::after { content:\"\"; position:absolute; left:-15%; right:-15%; bottom:0; height:320px; pointer-events:none;\n  background-image:linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);\n  background-size:52px 52px; transform:perspective(420px) rotateX(64deg); transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 0%,transparent 85%); mask-image:linear-gradient(to top,#000 0%,transparent 85%); }\n#ih-ps .eyebrow { display:inline-flex; align-items:center; gap:10px; padding:7px 15px 5px; border-radius:999px;\n  font-size:.78rem; font-weight:600; letter-spacing:.16em; text-transform:uppercase; }\n#ih-ps .eyebrow i { width:8px; height:8px; border-radius:50%; background:var(--orange); box-shadow:0 0 0 4px rgba(220,132,53,.2); }\n#ih-ps .light .eyebrow { color:var(--blue); background:#e7f2fb; border:1px solid #cbe2f5; }\n#ih-ps .dark .eyebrow { color:#fff; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.2); }\n#ih-ps .h2 { margin-top:16px; font-size:clamp(2rem,4.4vw,3.15rem); line-height:1.04; font-weight:500; letter-spacing:-.02em; color:var(--ink); }\n#ih-ps .dark .h2 { color:#fff; }\n#ih-ps .h2 em { font-style:normal; color:var(--blue); }\n#ih-ps .dark .h2 em { color:var(--orange-hi); }\n@supports ((-webkit-background-clip:text) or (background-clip:text)) {\n  #ih-ps .h2 em { background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }\n  #ih-ps .dark .h2 em { background:linear-gradient(90deg,#3aa6f5,#f29a4a); -webkit-background-clip:text; background-clip:text; color:transparent; }\n}\n#ih-ps .lead { margin-top:14px; max-width:62ch; font-size:1.1rem; line-height:1.6; }\n#ih-ps .light .lead { color:var(--char); }\n#ih-ps .dark .lead { color:#c9d1db; }\n#ih-ps .h2s-logo { height:30px; width:auto; }\n#ih-ps .h2s-text { display:inline-flex; align-items:center; height:30px; font-size:1.6rem; font-weight:700; letter-spacing:-.02em; line-height:1; padding-top:4px; }\n@media (max-width:560px) { #ih-ps .sec { padding:56px 0 60px; } #ih-ps .wrap { padding:0 18px; } }\n\n#ih-ps .sec { padding:64px 0 68px; }\n#ih-ps .head { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:12px 28px; }\n#ih-ps .head .lead { margin-top:10px; max-width:50ch; }\n#ih-ps .prep { display:flex; flex-wrap:wrap; gap:8px; margin-top:20px; }\n#ih-ps .prep li { display:inline-flex; align-items:center; gap:8px; padding:6px 14px 4px 6px; border-radius:999px; font-size:.88rem; color:var(--ink); background:rgba(255,255,255,.9); border:1px solid var(--line); box-shadow:0 4px 12px rgba(0,40,80,.05); }\n#ih-ps .prep i { width:24px; height:24px; border-radius:50%; display:grid; place-items:center; font-style:normal; font-size:.66rem; font-weight:700; color:#fff; padding-top:2px; }\n#ih-ps .prep li:nth-child(1) i { background:var(--blue); } #ih-ps .prep li:nth-child(2) i { background:var(--char); } #ih-ps .prep li:nth-child(3) i { background:var(--orange); }\n/* tabs (CSS-only; shows both tracks stacked if unsupported) */\n#ih-ps .tabs { margin-top:26px; }\n#ih-ps .tabs > input { position:absolute; opacity:0; width:1px; height:1px; pointer-events:none; }\n#ih-ps .tabbar { display:none; gap:12px; margin-bottom:16px; }\n#ih-ps .tabs:has(> input) .tabbar { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }\n#ih-ps .tab { display:flex; align-items:center; gap:14px; padding:12px 16px; border-radius:20px; cursor:pointer; background:#fff; border:1.5px solid var(--line);\n  box-shadow:0 6px 18px rgba(0,40,80,.06); transition:transform .25s ease, box-shadow .25s ease, background .25s ease; }\n#ih-ps .tab:hover { transform:translateY(-2px); }\n#ih-ps .tn { font-size:2.1rem; line-height:1; font-weight:700; letter-spacing:-.04em; color:#d5dce3; }\n#ih-ps .tab small { display:block; font-size:.66rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); }\n#ih-ps .tab b { display:block; margin-top:2px; font-size:1.1rem; font-weight:600; line-height:1.15; color:var(--ink); }\n#ih-ps .tabs > input:focus-visible + input + .tabbar .tab1, #ih-ps .tabs > input + input:focus-visible + .tabbar .tab2 { outline:3px solid var(--orange); outline-offset:3px; }\n#ih-ps .tabs > input:checked + input + .tabbar .tab1 { background:linear-gradient(135deg,#2a9af0,#0062ad); border-color:transparent; box-shadow:0 14px 32px rgba(0,112,192,.32); }\n#ih-ps .tabs > input + input:checked + .tabbar .tab2 { background:linear-gradient(135deg,#f7ad66,#c4651c); border-color:transparent; box-shadow:0 14px 32px rgba(220,132,53,.34); }\n#ih-ps .tabs > input:checked + input + .tabbar .tab1 :is(small,b), #ih-ps .tabs > input + input:checked + .tabbar .tab2 :is(small,b) { color:#fff; }\n#ih-ps .tabs > input:checked + input + .tabbar .tab1 .tn, #ih-ps .tabs > input + input:checked + .tabbar .tab2 .tn { color:rgba(255,255,255,.55); }\n#ih-ps .panel + .panel { margin-top:16px; }\n#ih-ps .tabs:has(> input) .panel + .panel { margin-top:0; }\n#ih-ps .tabs:has(> input:first-child:checked) .pan2 { display:none; }\n#ih-ps .tabs:has(> input:nth-child(2):checked) .pan1 { display:none; }\n#ih-ps .panel { animation:X-fade .4s ease; }\n@keyframes X-fade { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }\n\n/* inner scroll box: each track scrolls inside a fixed-height frame */\n#ih-ps .panel { position:relative; max-height:560px; overflow-y:auto; overflow-x:hidden; padding:12px 12px 0; border-radius:26px;\n  background:rgba(255,255,255,.55); border:1px solid var(--line); box-shadow:inset 0 1px 0 #fff, 0 12px 30px rgba(0,40,80,.06);\n  scrollbar-width:thin; scroll-behavior:smooth; -webkit-overflow-scrolling:touch; }\n#ih-ps .pan1 { scrollbar-color:#0070c0 rgba(0,112,192,.1); } #ih-ps .pan2 { scrollbar-color:#dc8435 rgba(220,132,53,.12); }\n#ih-ps .panel::-webkit-scrollbar { width:8px; } #ih-ps .panel::-webkit-scrollbar-track { margin:18px 0; border-radius:8px; background:rgba(0,40,80,.06); }\n#ih-ps .pan1::-webkit-scrollbar-thumb { border-radius:8px; background:#0070c0; } #ih-ps .pan2::-webkit-scrollbar-thumb { border-radius:8px; background:#dc8435; }\n#ih-ps .panel:focus-visible { outline:3px solid var(--orange); outline-offset:3px; }\n#ih-ps .panel::after { content:\"\"; position:sticky; bottom:0; display:block; height:44px; margin:-30px -12px 0; pointer-events:none;\n  background:linear-gradient(to bottom, rgba(247,250,253,0), rgba(247,250,253,.96) 75%); }\n#ih-ps .hint { display:flex; align-items:center; justify-content:flex-end; gap:6px; margin:-4px 4px 10px; font-size:.78rem; font-weight:600; letter-spacing:.04em; color:var(--muted); }\n#ih-ps .hint svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }\n#ih-ps .panel .foot { margin-bottom:12px; }\n@container (max-width:520px) { #ih-ps .panel { max-height:520px; padding:8px 8px 0; border-radius:22px; } #ih-ps .panel::after { margin:-30px -8px 0; } #ih-ps .hint { justify-content:flex-start; } }\n\n/* hero */\n#ih-ps .hero { position:relative; isolation:isolate; overflow:hidden; display:grid; grid-template-columns:minmax(0,1fr); gap:18px; padding:26px; border-radius:24px; color:#fff; }\n#ih-ps .pan1 .hero { background:radial-gradient(ellipse 70% 90% at 100% 100%, rgba(26,138,224,.85), transparent 70%), linear-gradient(160deg,#000 0%,#021a30 45%,#0070c0 100%); box-shadow:0 20px 44px rgba(0,60,120,.3); }\n#ih-ps .pan2 .hero { background:radial-gradient(ellipse 70% 90% at 100% 100%, rgba(242,154,74,.85), transparent 70%), linear-gradient(160deg,#000 0%,#2a1606 45%,#dc8435 100%); box-shadow:0 20px 44px rgba(140,70,20,.3); }\n#ih-ps .hero::after { content:\"\"; position:absolute; left:0; right:0; bottom:0; height:70%; z-index:-1;\n  background-image:linear-gradient(rgba(255,255,255,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.14) 1px,transparent 1px);\n  background-size:30px 30px; transform:perspective(260px) rotateX(60deg); transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 5%,transparent 85%); mask-image:linear-gradient(to top,#000 5%,transparent 85%); }\n#ih-ps .ht { display:flex; align-items:center; gap:12px; }\n#ih-ps .num { font-size:3rem; line-height:.9; font-weight:700; letter-spacing:-.05em; color:transparent; -webkit-text-stroke:1.5px rgba(255,255,255,.6); }\n#ih-ps .hero h3 { font-size:clamp(1.35rem,2.6vw,1.8rem); line-height:1.1; font-weight:700; letter-spacing:-.01em; color:#fff; }\n#ih-ps .stmt { margin-top:16px; padding-left:14px; border-left:3px solid; font-size:1.02rem; line-height:1.6; font-weight:500; color:#fff; }\n#ih-ps .sl { display:block; margin-top:16px; font-size:.64rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.75); }\n#ih-ps .sl + .stmt { margin-top:6px; }\n#ih-ps .pan1 .stmt { border-color:#5bb6f7; } #ih-ps .pan2 .stmt { border-color:#f7ad66; }\n#ih-ps .hard { align-self:center; padding:16px 18px; border-radius:16px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.26); backdrop-filter:blur(6px); }\n#ih-ps .gh { display:inline-flex; align-items:center; gap:8px; font-size:.66rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:#fff; }\n#ih-ps .gh::before { content:\"?\"; width:18px; height:18px; border-radius:50%; display:grid; place-items:center; font-size:.7rem; padding-top:2px; color:#05080d; background:#fff; }\n#ih-ps .hard p { margin-top:8px; font-size:1.08rem; line-height:1.45; font-weight:500; color:#fff; }\n#ih-ps .simple { margin-top:14px; padding:10px 14px; border-radius:14px; font-size:.95rem; line-height:1.45; color:var(--ink); background:rgba(255,255,255,.9); border:1px dashed; }\n#ih-ps .pan1 .simple { border-color:#9cc8ea; } #ih-ps .pan2 .simple { border-color:#efc29b; }\n#ih-ps .simple b { font-weight:700; } #ih-ps .pan1 .simple b { color:var(--blue); } #ih-ps .pan2 .simple b { color:#c06a1f; }\n/* cards */\n#ih-ps .cards { display:grid; grid-template-columns:minmax(0,1fr); gap:14px; margin-top:14px; }\n#ih-ps .foot { display:grid; grid-template-columns:minmax(0,1fr); gap:14px; margin-top:14px; }\n#ih-ps .foot .card { display:flex; flex-direction:column; }\n#ih-ps .help { margin-top:10px; font-size:.84rem; line-height:1.45; color:var(--muted); }\n#ih-ps .card { min-width:0; padding:18px 20px; border-radius:20px; background:rgba(255,255,255,.93); border:1px solid var(--line); box-shadow:0 10px 26px rgba(0,40,80,.06); backdrop-filter:blur(8px); }\n#ih-ps .ch { display:flex; align-items:center; gap:10px; }\n#ih-ps .ci { width:32px; height:32px; flex:none; border-radius:10px; display:grid; place-items:center; }\n#ih-ps .ci svg { width:17px; height:17px; fill:none; stroke:#fff; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }\n#ih-ps .ci:empty { display:none; }\n#ih-ps .pan1 .ci { background:linear-gradient(145deg,#2a9af0,#0062ad); } #ih-ps .pan2 .ci { background:linear-gradient(145deg,#f7ad66,#c96f22); }\n#ih-ps .card h4 { font-size:1.02rem; font-weight:700; line-height:1.2; color:var(--ink); }\n#ih-ps .ck { display:grid; gap:7px; margin-top:12px; }\n#ih-ps .ck li { display:grid; grid-template-columns:auto 1fr; gap:8px; align-items:start; font-size:.92rem; line-height:1.4; color:var(--ink); }\n#ih-ps .ck svg { width:16px; height:16px; margin-top:1px; fill:none; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }\n#ih-ps .pan1 .ck svg { stroke:var(--blue); } #ih-ps .pan2 .ck svg { stroke:var(--orange); }\n#ih-ps .exm { margin-top:10px; padding:10px 12px; border-radius:12px; font-size:.9rem; line-height:1.45; color:var(--ink); }\n#ih-ps .pan1 .exm { background:#eef6fd; border-left:4px solid var(--blue); } #ih-ps .pan2 .exm { background:#fdf3ea; border-left:4px solid var(--orange); }\n#ih-ps .lbl { display:block; margin-top:0; font-size:.64rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); }\n#ih-ps .tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }\n#ih-ps .tags li { padding:4px 10px 2px; border-radius:999px; font-size:.8rem; color:var(--ink); }\n#ih-ps .pan1 .tags li { background:#eef6fd; border:1px solid #d3e7f7; } #ih-ps .pan2 .tags li { background:#fdf3ea; border:1px solid #f5dcc3; }\n@container (min-width:760px) {\n  #ih-ps .hero { grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); gap:28px; padding:28px 30px; }\n  #ih-ps .cards { grid-template-columns:repeat(3,minmax(0,1fr)); }\n  #ih-ps .foot { grid-template-columns:minmax(0,1fr) minmax(0,1fr); }\n}\n@container (max-width:520px) {\n  #ih-ps .tab { padding:10px 12px; gap:8px; } #ih-ps .tn { font-size:1.5rem; } #ih-ps .tab b { font-size:.95rem; }\n  #ih-ps .hero { padding:20px 18px; } #ih-ps .card { padding:16px; } #ih-ps .num { font-size:2.3rem; }\n}\n@media (prefers-reduced-motion:reduce) { #ih-ps .panel { animation:none; } #ih-ps .tab { transition:none; } #ih-ps .tab:hover { transform:none; } }\n</style>\n\n<section class=\"sec light\" aria-labelledby=\"ih-ps-title\">\n  <div class=\"wrap\">\n    <div class=\"head\">\n      <div>\n        <span class=\"eyebrow\"><i aria-hidden=\"true\"></i>Two challenge tracks</span>\n        <h2 class=\"h2\" id=\"ih-ps-title\">Technical Challenge <em>Areas</em></h2>\n      </div>\n      <p class=\"lead\">Pick one track and build a reusable pipeline that tests what frontier AI can really do.</p>\n    </div>\n\n    <ul class=\"prep\" aria-label=\"Before you start\">\n      <li><i>✓</i>Working, repeatable prototype</li>\n      <li><i>&lt;/&gt;</i>Any language, Claude Code &amp; model APIs provided</li>\n      <li><i>↑</i>Code, samples, evidence &amp; demo</li>\n    </ul>\n\n    <div class=\"tabs\">\n      <input type=\"radio\" name=\"ih-ps-track\" id=\"ih-ps-r1\" checked>\n      <input type=\"radio\" name=\"ih-ps-track\" id=\"ih-ps-r2\">\n      <div class=\"tabbar\">\n        <label class=\"tab tab1\" for=\"ih-ps-r1\"><span class=\"tn\">01</span><span><small>Track 1</small><b>Coding Task Factory</b></span></label>\n        <label class=\"tab tab2\" for=\"ih-ps-r2\"><span class=\"tn\">02</span><span><small>Track 2</small><b>Visual Task Factory</b></span></label>\n      </div>\n      <p class=\"hint\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v16M8 8l4-4 4 4M8 16l4 4 4-4\"/></svg>Scroll inside the box to read the full track</p>\n      <div class=\"panel pan1\" tabindex=\"0\" role=\"region\" aria-labelledby=\"ih-ps-t1\">\n        <div class=\"hero\">\n          <div>\n            <div class=\"ht\"><span class=\"num\" aria-hidden=\"true\">01</span><h3 id=\"ih-ps-t1\">Track 1 — Coding Task Factory</h3></div>\n            <span class=\"sl\">Problem statement</span>\n            <p class=\"stmt\">Using a supplied repository and task interface, build one reusable strategy that generates feature-development tasks, each with clear requirements, a reference implementation, and tests that cover both the new feature and regressions. The hard part is not generating descriptions with an LLM: it is making tasks solvable, consistent with the repository, meaningfully different from each other, and reliably testable.</p>\n          </div>\n          <div class=\"hard\">\n            <span class=\"gh\">The big question</span>\n            <p>How can we automatically create realistic software-development tasks that are clear, solvable, and reliably testable?</p>\n          </div>\n        </div>\n        <p class=\"simple\"><b>In short:</b> turn a real codebase into new, testable coding tasks that fairly challenge AI coding systems.</p>\n        <div class=\"cards\">\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/></svg></span><h4>What you’ll build</h4></div><ul class=\"ck\"><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Clear, achievable requirements for a new feature</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A reference implementation that runs in the repo’s stack</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Feature tests plus regression checks for existing code</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Packages tagged to their starting repo version</span></li></ul></div>\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8z\"/></svg></span><h4>How to stand out</h4></div><ul class=\"ck\"><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Prove each implementation meets its requirements</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Show tests catch missing or incorrect behaviour</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Vary behaviour, rules or interactions, not just names</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Meaningful variation beats a high task count</span></li></ul></div>\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3\"/></svg></span><h4>What you’ll submit</h4></div><ul class=\"ck\"><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A reusable task-generation pipeline</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Sample task packages</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Validation evidence: tests, runs and results</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A live demo generating and validating a package</span></li></ul></div>\n        </div>\n        <div class=\"foot\">\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.6 1 2.5h6c0-.9.2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></svg></span><h4>Example</h4></div><p class=\"exm\">A shopping-cart app gets a generated task to add discount codes with eligibility rules and spending thresholds, plus tests that prove it works.</p></div>\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"/></svg></span><h4>Great fit if you enjoy</h4></div><ul class=\"tags\"><li>Extending existing codebases</li><li>Automating with model APIs</li><li>Writing testable requirements</li><li>Testing &amp; debugging</li><li>Evaluating AI coding systems</li></ul><p class=\"help\">Code-generation or AI-evaluation experience helps, but strong programming fundamentals matter most.</p></div>\n        </div>\n      </div>\n      <div class=\"panel pan2\" tabindex=\"0\" role=\"region\" aria-labelledby=\"ih-ps-t2\">\n        <div class=\"hero\">\n          <div>\n            <div class=\"ht\"><span class=\"num\" aria-hidden=\"true\">02</span><h3 id=\"ih-ps-t2\">Track 2 — Visual Task Factory</h3></div>\n            <span class=\"sl\">Problem statement</span>\n            <p class=\"stmt\">Choose a practical visual-understanding problem and build a pipeline that generates synthetic images, questions, and reference answers verified independently of the model being evaluated, then use it to assess frontier multimodal models. The hard part is ensuring the questions genuinely test vision, and the answers are trustworthy. Generating images and asking an LLM about them is not enough.</p>\n          </div>\n          <div class=\"hard\">\n            <span class=\"gh\">The big question</span>\n            <p>Which visual capabilities matter most in real-world applications, and how can we reliably test whether frontier AI models possess them?</p>\n          </div>\n        </div>\n        <p class=\"simple\"><b>In short:</b> create images and questions with answers you already know, then test how well top AI models really “see”.</p>\n        <div class=\"cards\">\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/></svg></span><h4>What you’ll build</h4></div><ul class=\"ck\"><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Pick an image family and a real-world visual problem</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Generate synthetic images and questions about them</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Reference answers checked without the tested model</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>An evaluation of frontier multimodal models</span></li></ul></div>\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8z\"/></svg></span><h4>How to stand out</h4></div><ul class=\"ck\"><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Every question needs genuine visual understanding</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Each image holds enough evidence to answer</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Vary visual relationships and reasoning, not just count</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Explain why errors matter in the real application</span></li></ul></div>\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3\"/></svg></span><h4>What you’ll submit</h4></div><ul class=\"ck\"><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A reusable generation and evaluation pipeline</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Sample tasks with validation evidence</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Findings on model strengths and weaknesses</span></li><li><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A demo where scoring separates right from wrong</span></li></ul></div>\n        </div>\n        <div class=\"foot\">\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.6 1 2.5h6c0-.9.2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></svg></span><h4>Example</h4></div><p class=\"exm\">Your code draws a bar chart, so it already knows which bar is tallest and can check every model’s answer.</p></div>\n          <div class=\"card\"><div class=\"ch\"><span class=\"ci\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"/></svg></span><h4>Great fit if you enjoy</h4></div><ul class=\"tags\"><li>Multimodal LLM APIs</li><li>Image generation</li><li>Structured data</li><li>Logic, algorithms &amp; testing</li><li>Designing experiments</li></ul><p class=\"help\">Experience with computer vision or synthetic data helps, but curiosity and careful reasoning matter most.</p></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n</div>",
