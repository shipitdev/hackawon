            "description": "<div class=\"ih\">\n<style>\n@import url(\"https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500&display=swap\");\nhtml { scroll-behavior: smooth; }\n.ih {\n  --black:#000; --grey:#f1f2f2; --white:#fff; --blue:#0070c0; --orange:#dc8435; --char:#474747;\n  font-family: \"League Spartan\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n  font-weight: 400; line-height: 1.6; color: var(--char); background: var(--white);\n}\n.ih *, .ih *::before, .ih *::after { box-sizing: border-box; }\n.ih h1,.ih h2,.ih h3,.ih h4,.ih p,.ih ul,.ih ol { margin: 0; padding: 0; }\n.ih ul,.ih ol { list-style: none; }\n.ih a { color: inherit; text-decoration: none; }\n.ih a:focus-visible, .ih summary:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }\n.ih .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }\n.ih .sec { padding: 80px 0; }\n.ih h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.15; font-weight: 400; color: var(--char); letter-spacing: -.01em; }\n.ih .lead { max-width: 60ch; margin-top: 16px; font-size: 1.1rem; }\n\n@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n/* Tracks */\n.ih .tracks { --ink: #0b0d10; --muted: #5f6670; --line: #e3e6ea; position: relative; overflow: hidden; background: #fff; color: var(--char); }\n.ih .tracks::before { content: \"\"; position: absolute; inset: 0; pointer-events: none;\n  background: radial-gradient(780px 540px at 0% 0%, rgba(0,112,192,.30), rgba(0,112,192,.08) 45%, transparent 72%), radial-gradient(600px 480px at 100% 40%, rgba(220,132,53,.16), transparent 70%), radial-gradient(720px 520px at 100% 100%, rgba(220,132,53,.34), rgba(220,132,53,.08) 45%, transparent 72%), radial-gradient(620px 440px at 0% 100%, rgba(0,112,192,.16), transparent 70%), linear-gradient(135deg, rgba(0,112,192,.05) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%, rgba(220,132,53,.06) 100%); }\n.ih .tracks::after { content: \"\"; position: absolute; left: -15%; right: -15%; bottom: 0; height: 360px; pointer-events: none;\n  background-image: linear-gradient(rgba(0,96,170,.17) 1px, transparent 1px), linear-gradient(90deg, rgba(0,96,170,.17) 1px, transparent 1px);\n  background-size: 58px 58px; transform: perspective(440px) rotateX(64deg); transform-origin: bottom;\n  -webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0,0,0,.6) 35%, transparent 85%); mask-image: linear-gradient(to top, #000 0%, rgba(0,0,0,.6) 35%, transparent 85%); }\n.ih .tracks .wrap { position: relative; z-index: 1; }\n.ih .tracks h2 { color: var(--ink); }\n.ih .tracks h2 em { font-style: normal; color: var(--blue); }\n@supports ((-webkit-background-clip: text) or (background-clip: text)) {\n  .ih .tracks h2 em { background: linear-gradient(90deg, #1a8ae0 0%, #dc8435 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n}\n.ih .tracks .lead { color: var(--char); }\n.ih .tc-prep { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }\n.ih .tc-prep li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px 6px 6px; border-radius: 999px; font-size: 1rem; color: var(--ink); background: rgba(255,255,255,.9); border: 1px solid var(--line); box-shadow: 0 4px 12px rgba(0,40,80,.05); }\n.ih .tc-prep i { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-style: normal; font-size: .75rem; font-weight: 500; color: #fff; }\n.ih .tc-prep li:nth-child(1) i { background: var(--blue); }\n.ih .tc-prep li:nth-child(2) i { background: var(--char); }\n.ih .tc-prep li:nth-child(3) i { background: var(--orange); }\n.ih .tc-tabs { margin-top: 28px; }\n.ih .tc-tabs > input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }\n.ih .tc-tabbar { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }\n.ih .tc-tab { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 20px; cursor: pointer; background: #fff; border: 1.5px solid var(--line); box-shadow: 0 6px 18px rgba(0,40,80,.06); transition: transform .25s ease, box-shadow .25s ease; }\n.ih .tc-tab:hover { transform: translateY(-2px); }\n.ih .tc-tn { font-size: 2.1rem; line-height: 1; font-weight: 300; letter-spacing: -.04em; color: #d5dce3; }\n.ih .tc-tab small { display: block; font-size: .9rem; color: var(--muted); }\n.ih .tc-tab b { display: block; margin-top: 2px; font-size: 1.15rem; font-weight: 500; line-height: 1.15; color: var(--ink); }\n#ih-tr-1:checked ~ .tc-tabbar label[for=\"ih-tr-1\"] { background: linear-gradient(135deg, #2a9af0, #0062ad); border-color: transparent; box-shadow: 0 14px 32px rgba(0,112,192,.32); }\n#ih-tr-2:checked ~ .tc-tabbar label[for=\"ih-tr-2\"] { background: linear-gradient(135deg, #f7ad66, #c4651c); border-color: transparent; box-shadow: 0 14px 32px rgba(220,132,53,.34); }\n#ih-tr-1:checked ~ .tc-tabbar label[for=\"ih-tr-1\"] small, #ih-tr-1:checked ~ .tc-tabbar label[for=\"ih-tr-1\"] b,\n#ih-tr-2:checked ~ .tc-tabbar label[for=\"ih-tr-2\"] small, #ih-tr-2:checked ~ .tc-tabbar label[for=\"ih-tr-2\"] b { color: #fff; }\n#ih-tr-1:checked ~ .tc-tabbar label[for=\"ih-tr-1\"] .tc-tn, #ih-tr-2:checked ~ .tc-tabbar label[for=\"ih-tr-2\"] .tc-tn { color: rgba(255,255,255,.55); }\n#ih-tr-1:focus-visible ~ .tc-tabbar label[for=\"ih-tr-1\"], #ih-tr-2:focus-visible ~ .tc-tabbar label[for=\"ih-tr-2\"] { outline: 3px solid var(--orange); outline-offset: 3px; }\n#ih-tr-1:checked ~ .tc-p2 { display: none; }\n#ih-tr-2:checked ~ .tc-p1 { display: none; }\n@keyframes tc-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }\n.ih .tc-panel { --c: var(--blue); --tint: #eef6fd; --tint-b: #d3e7f7; --dash: #9cc8ea; --bar: #5bb6f7; --em: var(--blue); --chip: linear-gradient(145deg, #2a9af0, #0062ad);\n  display: grid; gap: 14px; align-content: start; animation: tc-fade .4s ease; }\n.ih .tc-panel.o { --c: var(--orange); --tint: #fdf3ea; --tint-b: #f5dcc3; --dash: #efc29b; --bar: #f7ad66; --em: #c06a1f; --chip: linear-gradient(145deg, #f7ad66, #c96f22); }\n.ih .tc { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 22px; padding: 26px; border-radius: 24px; color: #fff;\n  background: radial-gradient(ellipse 70% 90% at 100% 100%, rgba(26,138,224,.85), transparent 70%), linear-gradient(160deg, #000 0%, #021a30 45%, #0070c0 100%); box-shadow: 0 20px 44px rgba(0,60,120,.3); }\n.ih .tc-panel.o .tc { background: radial-gradient(ellipse 70% 90% at 100% 100%, rgba(242,154,74,.85), transparent 70%), linear-gradient(160deg, #000 0%, #2a1606 45%, #dc8435 100%); box-shadow: 0 20px 44px rgba(140,70,20,.3); }\n.ih .tc::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: 0; height: 70%; z-index: -1;\n  background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px);\n  background-size: 30px 30px; transform: perspective(260px) rotateX(60deg); transform-origin: bottom;\n  -webkit-mask-image: linear-gradient(to top, #000 5%, transparent 85%); mask-image: linear-gradient(to top, #000 5%, transparent 85%); }\n.ih .tc-ht { display: flex; align-items: center; gap: 14px; }\n.ih .tc-num { font-size: clamp(2.6rem, 5vw, 3.4rem); font-weight: 300; line-height: .9; letter-spacing: -.05em; color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,.6); }\n@supports not (-webkit-text-stroke: 1px #000) { .ih .tc-num { color: rgba(255,255,255,.5); } }\n.ih .pill { display: inline-block; padding: 4px 14px; border-radius: 999px; font-size: .95rem; font-weight: 500; color: #fff; background: rgba(255,255,255,.16); }\n.ih .tc h3 { margin-top: 6px; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 400; line-height: 1.15; color: #fff; }\n.ih .tc-q { align-self: center; padding: 16px 18px; border-radius: 16px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.26); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }\n.ih .tc-gh { display: inline-flex; align-items: center; gap: 8px; font-size: .95rem; font-weight: 500; color: #fff; }\n.ih .tc-gh::before { content: \"?\"; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .8rem; padding-top: 1px; color: var(--black); background: #fff; }\n.ih .tc-q p { margin-top: 8px; font-size: clamp(1.15rem, 2vw, 1.35rem); font-weight: 300; line-height: 1.45; color: #fff; }\n.ih .tc-sl { display: block; margin-top: 20px; font-size: .95rem; font-weight: 500; color: rgba(255,255,255,.75); }\n.ih .tc-st { position: relative; display: flex; flex-direction: column; margin-top: 8px; padding-left: 14px; border-left: 3px solid var(--bar); }\n.ih .tc-st p { font-size: 1.03rem; line-height: 1.6; color: #fff; }\n.ih .tc-st > input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }\n.ih .tc-ps-more { display: none; order: 1; }\n.ih .tc-ps-more p { margin-top: 12px; }\n.ih .tc-rm { order: 2; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; padding: 7px 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.45); color: #fff; font-size: .98rem; font-weight: 500; cursor: pointer; }\n.ih .tc-rm::after { content: \"+\"; font-size: 1.2rem; line-height: 1; padding-bottom: 2px; }\n.ih .tc-rm:hover { background: rgba(255,255,255,.14); border-color: #fff; }\n.ih .tc-st > input:checked ~ .tc-ps-more { display: block; }\n.ih .tc-st > input:checked ~ .tc-rm::after { content: \"\\2212\"; }\n.ih .tc-r2 { display: none; }\n.ih .tc-st > input:checked ~ .tc-rm .tc-r1 { display: none; }\n.ih .tc-st > input:checked ~ .tc-rm .tc-r2 { display: inline; }\n.ih .tc-st > input:focus-visible ~ .tc-rm { outline: 3px solid var(--orange); outline-offset: 3px; }\n.ih .tc-st a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }\n.ih .tc-st a:hover { color: #ffd9b3; }\n.ih .tc-short { padding: 12px 16px; border-radius: 14px; background: rgba(255,255,255,.9); border: 1px dashed var(--dash); font-size: 1rem; line-height: 1.45; color: var(--ink); }\n.ih .tc-short b { font-weight: 500; color: var(--em); }\n.ih .tc-more summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; border-radius: 20px; background: rgba(255,255,255,.93); border: 1px solid var(--line); box-shadow: 0 10px 26px rgba(0,40,80,.06); color: var(--ink); cursor: pointer; list-style: none; }\n.ih .tc-more summary::-webkit-details-marker { display: none; }\n.ih .tc-more summary:hover { border-color: var(--dash); }\n.ih .tc-more summary b { display: block; font-size: 1.15rem; font-weight: 500; line-height: 1.2; color: var(--ink); }\n.ih .tc-more summary small { display: block; margin-top: 2px; font-size: .92rem; color: var(--muted); }\n.ih .tc-more summary::after { content: \"+\"; flex: none; width: 36px; height: 36px; padding-bottom: 3px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; line-height: 1; color: #fff; background: var(--chip); }\n.ih .tc-more[open] summary::after { content: \"\\2212\"; }\n.ih .tc-less { display: none; }\n.ih .tc-more[open] .tc-open { display: none; }\n.ih .tc-more[open] .tc-less { display: inline; }\n.ih .tc-sec { min-width: 0; padding: 18px 20px; border-radius: 20px; background: rgba(255,255,255,.93); border: 1px solid var(--line); box-shadow: 0 10px 26px rgba(0,40,80,.06); }\n.ih .tc-sh { display: flex; align-items: center; gap: 10px; }\n.ih .tc-ic { flex: none; width: 36px; height: 36px; border-radius: 11px; display: flex; align-items: center; justify-content: center; background: var(--chip); }\n.ih .tc-ic svg { width: 19px; height: 19px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n.ih .tc-sh h4 { font-size: 1.1rem; font-weight: 500; line-height: 1.2; color: var(--ink); }\n.ih .tc-ck { display: grid; gap: 8px; margin-top: 12px; }\n.ih .tc-ck li { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: start; font-size: 1rem; line-height: 1.4; color: var(--ink); }\n.ih .tc-ck svg { width: 17px; height: 17px; margin-top: 2px; fill: none; stroke: var(--c); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }\n.ih .tc-ex { margin-top: 12px; padding: 10px 14px; border-radius: 12px; background: var(--tint); border-left: 4px solid var(--c); font-size: 1rem; line-height: 1.45; color: var(--ink); }\n.ih .tc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }\n.ih .tc-tags li { padding: 4px 12px; border-radius: 999px; background: var(--tint); border: 1px solid var(--tint-b); font-size: .92rem; color: var(--ink); }\n.ih .tc-help { margin-top: 10px; font-size: .92rem; line-height: 1.45; color: var(--muted); }\n.ih .tc-cards, .ih .tc-foot { display: grid; gap: 14px; margin-top: 14px; }\n@media (min-width: 760px) {\n  .ih .tc { grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr); gap: 36px; padding: 34px 36px; }\n  .ih .tc-cards { grid-template-columns: repeat(3, minmax(0,1fr)); }\n  .ih .tc-foot { grid-template-columns: 1fr 1fr; }\n}\n@media (max-width: 520px) {\n  .ih .tc-tab { padding: 10px 12px; gap: 8px; }\n  .ih .tc-tn { font-size: 1.5rem; }\n  .ih .tc-tab b { font-size: 1rem; }\n  .ih .tc { padding: 22px 18px; }\n}\n@media (prefers-reduced-motion: reduce) { .ih .tc-panel { animation: none; } .ih .tc-tab { transition: none; } .ih .tc-tab:hover { transform: none; } }\n</style>\n\n<section class=\"sec tracks\" id=\"tracks\">\n  <div class=\"wrap\">\n    <h2>Two tracks. One goal: <em>tests that AI models can’t shortcut.</em></h2>\n    <p class=\"lead\">Pick a track and build a reusable pipeline.</p>\n    <ul class=\"tc-prep\" aria-label=\"Before you start\">\n      <li><i>✓</i>Working, repeatable prototype</li>\n      <li><i>&lt;/&gt;</i>Any language, AI credits &amp; model APIs provided</li>\n      <li><i>↑</i>Code, samples, evidence &amp; demo</li>\n    </ul>\n    <div class=\"tc-tabs\">\n      <input type=\"radio\" name=\"ih-tr-track\" id=\"ih-tr-1\" checked>\n      <input type=\"radio\" name=\"ih-tr-track\" id=\"ih-tr-2\">\n      <div class=\"tc-tabbar\">\n        <label class=\"tc-tab\" for=\"ih-tr-1\"><span class=\"tc-tn\">01</span><span><small>Track 1</small><b>Coding Task Factory</b></span></label>\n        <label class=\"tc-tab\" for=\"ih-tr-2\"><span class=\"tc-tn\">02</span><span><small>Track 2</small><b>Visual Task Factory</b></span></label>\n      </div>\n      <div class=\"tc-panel tc-p1\">\n        <div class=\"tc\">\n          <div>\n            <div class=\"tc-ht\"><span class=\"tc-num\" aria-hidden=\"true\">01</span><div><span class=\"pill\">Track 1</span><h3>Coding Task Factory</h3></div></div>\n            <span class=\"tc-sl\">Problem statement</span>\n            <div class=\"tc-st\">\n              <p>Using a supplied working software repository and <a href=\"https://www.harborframework.com/\" target=\"_blank\" rel=\"noopener noreferrer\">task interface</a>, your team will build one reusable strategy for generating realistic feature-development tasks suitable for evaluating AI coding systems.</p>\n              <input type=\"checkbox\" id=\"ih-tr-m1\" aria-label=\"Show the full problem statement\">\n              <div class=\"tc-ps-more\">\n              <p>Each task package should contain clear, achievable requirements, a reference implementation, and tests that verify the new feature while protecting existing functionality. Packages must identify their starting repository version and follow the supplied task interface.</p>\n              <p>Reference implementations and tests must work with the repository’s language, framework, dependencies, and execution environment. Validation evidence should show that implementations satisfy the requirements, feature tests detect missing or incorrect behavior, and regression checks protect existing functionality.</p>\n              </div>\n              <label class=\"tc-rm\" for=\"ih-tr-m1\"><span class=\"tc-r1\">Read more</span><span class=\"tc-r2\">Show less</span></label>\n            </div>\n          </div>\n          <div class=\"tc-q\"><span class=\"tc-gh\">The big question</span><p>How can we automatically create realistic software-development tasks that are clear, solvable, and reliably testable?</p></div>\n        </div>\n        <p class=\"tc-short\"><b>In short:</b> turn a real codebase into new, testable coding tasks that fairly challenge AI coding systems.</p>\n        <details class=\"tc-more\">\n          <summary><span><b><span class=\"tc-open\">Read more</span><span class=\"tc-less\">Show less</span></b><small>What you’ll build, how to stand out and what you’ll submit</small></span></summary>\n          <div class=\"tc-cards\">\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/></svg></span><h4>What you’ll build</h4></div><ul class=\"tc-ck\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Clear, achievable requirements for a new feature</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A reference implementation that runs in the repo’s stack</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Feature tests plus regression checks for existing code</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Packages tagged to their starting repo version</span></li></ul></div>\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8z\"/></svg></span><h4>How to stand out</h4></div><ul class=\"tc-ck\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Prove each implementation meets its requirements</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Show tests catch missing or incorrect behaviour</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Vary behaviour, rules or interactions, not just names</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Meaningful variation beats a high task count</span></li></ul></div>\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3\"/></svg></span><h4>What you’ll submit</h4></div><ul class=\"tc-ck\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A reusable task-generation pipeline</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Sample task packages</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Validation evidence: tests, runs and results</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A live demo generating and validating a package</span></li></ul></div>\n          </div>\n          <div class=\"tc-foot\">\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.6 1 2.5h6c0-.9.2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></svg></span><h4>Example</h4></div><p class=\"tc-ex\">A shopping-cart app gets a generated task to add discount codes with eligibility rules and spending thresholds, plus tests that prove it works.</p></div>\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"/></svg></span><h4>Great fit if you enjoy</h4></div><ul class=\"tc-tags\"><li>Extending existing codebases</li><li>Automating with model APIs</li><li>Writing testable requirements</li><li>Testing &amp; debugging</li><li>Evaluating AI coding systems</li></ul><p class=\"tc-help\">Code-generation or AI-evaluation experience helps, but strong programming fundamentals matter most.</p></div>\n          </div>\n        </details>\n      </div>\n      <div class=\"tc-panel tc-p2 o\">\n        <div class=\"tc\">\n          <div>\n            <div class=\"tc-ht\"><span class=\"tc-num\" aria-hidden=\"true\">02</span><div><span class=\"pill\">Track 2</span><h3>Visual Task Factory</h3></div></div>\n            <span class=\"tc-sl\">Problem statement</span>\n            <div class=\"tc-st\">\n              <p>Your team will choose an image family and visual-understanding problem with meaningful practical impact. Build an automated pipeline that generates synthetic images, questions about those images, and verifiable reference answers.</p>\n              <input type=\"checkbox\" id=\"ih-tr-m2\" aria-label=\"Show the full problem statement\">\n              <div class=\"tc-ps-more\">\n              <p>Explain the application your chosen problem supports, why errors matter, and how your synthetic examples represent its visual challenges. Teams choose their image family, application domain, and generation approach.</p>\n              <p>Each task must require visual understanding, provide sufficient image evidence to answer the question, and include a reliable method for checking the answer. Explain how reference answers are established and validated independently of the model being evaluated. Use the generated tasks to evaluate advanced multimodal models and investigate their strengths and weaknesses.</p>\n              </div>\n              <label class=\"tc-rm\" for=\"ih-tr-m2\"><span class=\"tc-r1\">Read more</span><span class=\"tc-r2\">Show less</span></label>\n            </div>\n          </div>\n          <div class=\"tc-q\"><span class=\"tc-gh\">The big question</span><p>Which visual capabilities matter most in real-world applications, and how can we reliably test whether advanced AI models possess them?</p></div>\n        </div>\n        <p class=\"tc-short\"><b>In short:</b> create images and questions with answers you already know, then test how well top AI models really “see”.</p>\n        <details class=\"tc-more\">\n          <summary><span><b><span class=\"tc-open\">Read more</span><span class=\"tc-less\">Show less</span></b><small>What you’ll build, how to stand out and what you’ll submit</small></span></summary>\n          <div class=\"tc-cards\">\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/></svg></span><h4>What you’ll build</h4></div><ul class=\"tc-ck\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Pick an image family and a real-world visual problem</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Generate synthetic images and questions about them</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Reference answers checked without the tested model</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>An evaluation of advanced multimodal models</span></li></ul></div>\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.8z\"/></svg></span><h4>How to stand out</h4></div><ul class=\"tc-ck\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Every question needs genuine visual understanding</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Each image holds enough evidence to answer</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Vary visual relationships and reasoning, not just count</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Explain why errors matter in the real application</span></li></ul></div>\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3\"/></svg></span><h4>What you’ll submit</h4></div><ul class=\"tc-ck\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A reusable generation and evaluation pipeline</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Sample tasks with validation evidence</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>Findings on model strengths and weaknesses</span></li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg><span>A demo where scoring separates right from wrong</span></li></ul></div>\n          </div>\n          <div class=\"tc-foot\">\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.6 1 2.5h6c0-.9.2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></svg></span><h4>Example</h4></div><p class=\"tc-ex\">Your code draws a bar chart, so it already knows which bar is tallest and can check every model’s answer.</p></div>\n            <div class=\"tc-sec\"><div class=\"tc-sh\"><span class=\"tc-ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"/></svg></span><h4>Great fit if you enjoy</h4></div><ul class=\"tc-tags\"><li>Multimodal LLM APIs</li><li>Image generation</li><li>Structured data</li><li>Logic, algorithms &amp; testing</li><li>Designing experiments</li></ul><p class=\"tc-help\">Experience with computer vision or synthetic data helps, but curiosity and careful reasoning matter most.</p></div>\n          </div>\n        </details>\n      </div>\n    </div>\n  </div>\n</section>\n</div>",
