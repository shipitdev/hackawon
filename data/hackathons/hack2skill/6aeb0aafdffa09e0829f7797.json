er-events:none;\n  background:\n    radial-gradient(780px 540px at 0% 0%, rgba(0,112,192,.30), rgba(0,112,192,.08) 45%, transparent 72%),\n    radial-gradient(600px 480px at 100% 40%, rgba(220,132,53,.16), transparent 70%),\n    radial-gradient(720px 520px at 100% 100%, rgba(220,132,53,.34), rgba(220,132,53,.08) 45%, transparent 72%),\n    radial-gradient(620px 440px at 0% 100%, rgba(0,112,192,.16), transparent 70%),\n    linear-gradient(135deg, rgba(0,112,192,.05) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%, rgba(220,132,53,.06) 100%); }\n#ih-about .light::after { content:\"\"; position:absolute; left:-15%; right:-15%; bottom:0; height:360px; pointer-events:none;\n  background-image:linear-gradient(rgba(0,96,170,.17) 1px, transparent 1px), linear-gradient(90deg, rgba(0,96,170,.17) 1px, transparent 1px);\n  background-size:58px 58px; transform:perspective(440px) rotateX(64deg); transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 35%,transparent 85%); mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 35%,transparent 85%); }\n#ih-about .dark { background:#04070c; color:#c9d1db; }\n#ih-about .dark::before { content:\"\"; position:absolute; inset:0; pointer-events:none;\n  background:\n    radial-gradient(ellipse 45% 60% at 0% 0%, rgba(0,112,192,.55), transparent 70%),\n    radial-gradient(ellipse 40% 55% at 100% 100%, rgba(220,132,53,.45), transparent 70%); }\n#ih-about .dark::after { content:\"\"; position:absolute; left:-15%; right:-15%; bottom:0; height:320px; pointer-events:none;\n  background-image:linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);\n  background-size:52px 52px; transform:perspective(420px) rotateX(64deg); transform-origin:bottom;\n  -webkit-mask-image:linear-gradient(to top,#000 0%,transparent 85%); mask-image:linear-gradient(to top,#000 0%,transparent 85%); }\n#ih-about .eyebrow { display:inline-flex; align-items:center; gap:10px; padding:7px 15px 5px; border-radius:999px;\n  font-size:.78rem; font-weight:600; letter-spacing:.16em; text-transform:uppercase; }\n#ih-about .eyebrow i { width:8px; height:8px; border-radius:50%; background:var(--orange); box-shadow:0 0 0 4px rgba(220,132,53,.2); }\n#ih-about .light .eyebrow { color:var(--blue); background:#e7f2fb; border:1px solid #cbe2f5; }\n#ih-about .dark .eyebrow { color:#fff; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.2); }\n#ih-about .h2 { margin-top:16px; font-size:clamp(2rem,4.4vw,3.15rem); line-height:1.04; font-weight:500; letter-spacing:-.02em; color:var(--ink); }\n#ih-about .dark .h2 { color:#fff; }\n#ih-about .h2 em { font-style:normal; color:var(--blue); }\n#ih-about .dark .h2 em { color:var(--orange-hi); }\n@supports ((-webkit-background-clip:text) or (background-clip:text)) {\n  #ih-about .h2 em { background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }\n  #ih-about .dark .h2 em { background:linear-gradient(90deg,#3aa6f5,#f29a4a); -webkit-background-clip:text; background-clip:text; color:transparent; }\n}\n#ih-about .lead { margin-top:14px; max-width:62ch; font-size:1.1rem; line-height:1.6; }\n#ih-about .light .lead { color:var(--char); }\n#ih-about .dark .lead { color:#c9d1db; }\n#ih-about .h2s-logo { height:30px; width:auto; }\n#ih-about .h2s-text { display:inline-flex; align-items:center; height:30px; font-size:1.6rem; font-weight:700; letter-spacing:-.02em; line-height:1; padding-top:4px; }\n@media (max-width:560px) { #ih-about .sec { padding:56px 0 60px; } #ih-about .wrap { padding:0 18px; } }\n \n#ih-about .grid { display:grid; grid-template-columns:minmax(0,1fr); gap:24px; align-items:start; }\n#ih-about .copy { position:relative; padding:24px 26px; border-radius:22px; background:rgba(255,255,255,.85); border:1.5px solid transparent;\n  background:linear-gradient(rgba(255,255,255,.9),rgba(255,255,255,.9)) padding-box, linear-gradient(130deg,#1a8ae0,#dc8435) border-box; box-shadow:0 16px 36px rgba(0,40,80,.08); backdrop-filter:blur(10px); }\n#ih-about .copy p { font-size:1.06rem; line-height:1.65; color:var(--char); }\n#ih-about .copy p + p { margin-top:14px; }\n#ih-about .copy b { font-weight:600; color:var(--ink); }\n#ih-about .copy .hl { font-weight:600; color:var(--blue); }\n#ih-about .copy .hl2 { font-weight:600; color:#c06a1f; }\n \n#ih-about .facts { display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }\n#ih-about .facts li { display:inline-flex; align-items:baseline; gap:6px; padding:7px 14px 5px; border-radius:999px; font-size:.9rem; color:var(--char); background:rgba(255,255,255,.85); border:1px solid var(--line); box-shadow:0 6px 16px rgba(0,40,80,.06); }\n#ih-about .facts b { font-weight:700; color:var(--blue); }\n#ih-about .facts li:nth-child(even) b { color:#c06a1f; }\n \n \n#ih-about .pillars { display:grid; grid-template-columns:minmax(0,1fr); gap:14px; margin-top:32px; }\n#ih-about .pillar { position:relative; overflow:hidden; display:flex; align-items:center; gap:16px; padding:22px 22px; border-radius:20px; color:#fff;\n  transition:transform .3s ease, box-shadow .3s ease; }\n#ih-about .pillar:hover { transform:translateY(-4px); }\n#ih-about .pillar::after { content:\"\"; position:absolute; right:-30px; top:-30px; width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,.12); }\n#ih-about .p1 { background:linear-gradient(135deg,#1a8ae0,#0058a0); box-shadow:0 16px 34px rgba(0,112,192,.32); }\n#ih-about .p2 { background:linear-gradient(135deg,#2a2f36,#0b0d10); box-shadow:0 16px 34px rgba(0,0,0,.25); }\n#ih-about .p3 { background:linear-gradient(135deg,#f29a4a,#c4651c); box-shadow:0 16px 34px rgba(220,132,53,.34); }\n#ih-about .pi { width:52px; height:52px; flex:none; border-radius:15px; display:grid; place-items:center; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.35); }\n#ih-about .pi svg { width:26px; height:26px; fill:none; stroke:#fff; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }\n#ih-about .pillar h3 { font-size:1.35rem; font-weight:600; line-height:1.1; color:#fff; }\n#ih-about .pillar p { margin-top:4px; font-size:.95rem; line-height:1.4; color:rgba(255,255,255,.9); }\n \n@container (min-width:852px) {\n  #ih-about .grid { grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr); gap:48px; align-items:center; }\n  #ih-about .pillars { grid-template-columns:repeat(3,minmax(0,1fr)); }\n}\n@container (max-width:512px) {\n        }\n@media (prefers-reduced-motion:reduce) { #ih-about .pillar { transition:none; } #ih-about .pillar:hover { transform:none; } }\n@container (max-width:512px) { #ih-about .copy { padding:18px; } #ih-about .copy p { font-size:1rem; } }\n</style>\n \n<section class=\"sec light\" aria-labelledby=\"ih-about-title\">\n  <div class=\"wrap\">\n    <div class=\"grid\">\n      <div class=\"lead-col\">\n        <h2 class=\"h2\" id=\"ih-about-title\">An AI engineering and evaluation challenge built for <em>real-world impact.</em></h2>\n        <ul class=\"facts\">\n          <li><b>2</b> tracks</li>\n          <li><b>Virtual</b> build phase</li>\n          <li><b>₹10 Lakh</b> prize pool</li>\n          <li><b>Grand Finale</b> in New Delhi</li>\n        </ul>\n      </div>\n      <div class=\"copy\">\n        <p>The <b>Innodata Frontier AI Hackathon 2026</b> is a nationwide AI engineering challenge, hosted by <b>Innodata</b> and powered by <b>Hack2skill</b>.</p>\n        <p>This isn’t your average app-building event. Teams <span class=\"hl\">build, test and benchmark</span> next-generation AI systems, from synthetic data generators to automated testing pipelines that reveal what frontier models can really do.</p>\n        <p>As Innodata advances as a global AI-native company, we’re inviting India’s top <span class=\"hl2\">AI/ML talent, developers and campus innovators</span> to solve real-world AI engineering problems, with expert mentorship along the way.</p>\n      </div>\n    </div>\n \n    <ul class=\"pillars\">\n      <li class=\"pillar p1\">\n        <span class=\"pi\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z\"/></svg></span>\n        <div><h3>Build</h3><p>Reusable pipelines that generate evaluation tasks and data.</p></div>\n      </li>\n      <li class=\"pillar p2\">\n        <span class=\"pi\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z\"/><path d=\"M8.5 12l2.5 2.5 4.5-5\"/></svg></span>\n        <div><h3>Test</h3><p>Verifiable checks that frontier models can’t shortcut.</p></div>\n      </li>\n      <li class=\"pillar p3\">\n        <span class=\"pi\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg></span>\n        <div><h3>Benchmark</h3><p>Measure how frontier AI models really perform.</p></div>\n      </li>\n    </ul>\n  </div>\n</section>\n</div>",
