  "description": "IBM Z Datathon 2026 - Interactive Master Layout /* --- Scoped Variables & Platform Protection Namespace --- */ .ibm-mainframe-datathon-container { --ibm-white: #ffffff; --ibm-gray-10: #f4f4f4; --ibm-gray-20: #e0e0e0; --ibm-gray-30: #c6c6c6; --ibm-gray-70: #525252; --ibm-gray-100: #161616; /* IBM Design Color Core tokens */ --ibm-blue-60: #0f62fe; --ibm-blue-70: #0043ce; --ibm-purple-60: #8a3ffc; --ibm-teal-50: #007d79; --ibm-magenta-60: #d12771; --transition-main: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); --font-stack: 'Open Sans', sans-serif; /* Container Setup */ box-sizing: border-box; font-family: var(--font-stack); background-color: #fafafa; padding: 24px 15px; display: flex; flex-direction: column; align-items: center; width: 100%; } /* Safe container elements reset (No universal asterisk selector) */ .ibm-mainframe-datathon-container div, .ibm-mainframe-datathon-container section, .ibm-mainframe-datathon-container header, .ibm-mainframe-datathon-container footer, .ibm-mainframe-datathon-container h2, .ibm-mainframe-datathon-container h3, .ibm-mainframe-datathon-container h4, .ibm-mainframe-datathon-container p, .ibm-mainframe-datathon-container span, .ibm-mainframe-datathon-container svg, .ibm-mainframe-datathon-container strong { box-sizing: border-box; margin: 0; padding: 0; } /* --- Strict Typography Control (18px Headings/Boxes / 16px Text) --- */ .ibm-mainframe-datathon-container .hero-title, .ibm-mainframe-datathon-container .block-section-title, .ibm-mainframe-datathon-container .metric-val, .ibm-mainframe-datathon-container .interactive-card-heading, .ibm-mainframe-datathon-container .profile-banner-heading, .ibm-mainframe-datathon-container .theme-section-heading { font-size: 18px !important; font-family: var(--font-stack); } .ibm-mainframe-datathon-container .badge-pill, .ibm-mainframe-datathon-container .hero-description, .ibm-mainframe-datathon-container .about-text-block p, .ibm-mainframe-datathon-container .theme-pointer-text, .ibm-mainframe-datat",
