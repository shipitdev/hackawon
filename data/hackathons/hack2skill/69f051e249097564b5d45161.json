          "item": {
            "description": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>IBM Z Datathon 2026 - Interactive Master Layout</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* --- Scoped Variables & Platform Protection Namespace --- */\n        .ibm-mainframe-datathon-container {\n            --ibm-white: #ffffff;\n            --ibm-gray-10: #f4f4f4;\n            --ibm-gray-20: #e0e0e0;\n            --ibm-gray-30: #c6c6c6;\n            --ibm-gray-70: #525252;\n            --ibm-gray-100: #161616;\n            \n            /* IBM Design Color Core tokens */\n            --ibm-blue-60: #0f62fe;\n            --ibm-blue-70: #0043ce;\n            --ibm-purple-60: #8a3ffc;\n            --ibm-teal-50: #007d79;\n            --ibm-magenta-60: #d12771;\n            \n            --transition-main: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n            --font-stack: 'Open Sans', sans-serif;\n            \n            /* Container Setup */\n            box-sizing: border-box;\n            font-family: var(--font-stack);\n            background-color: #fafafa;\n            padding: 24px 15px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            width: 100%;\n        }\n\n        /* Safe container elements reset (No universal asterisk selector) */\n        .ibm-mainframe-datathon-container div,\n        .ibm-mainframe-datathon-container section,\n        .ibm-mainframe-datathon-container header,\n        .ibm-mainframe-datathon-container footer,\n        .ibm-mainframe-datathon-container h2,\n        .ibm-mainframe-datathon-container h3,\n        .ibm-mainframe-datathon-container h4,\n        .ibm-mainframe-datathon-container p,\n        .ibm-mainframe-datathon-container span,\n        .ibm-mainframe-datathon-container svg,\n        .ibm-mainframe-datathon-container strong {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        /* --- Strict Typography Control (18px Headings/Boxes / 16px Text) --- */\n        .ibm-mainframe-datathon-container .hero-title,\n        .ibm-mainframe-datathon-container .block-section-title,\n        .ibm-mainframe-datathon-container .metric-val,\n        .ibm-mainframe-datathon-container .interactive-card-heading,\n        .ibm-mainframe-datathon-container .profile-banner-heading,\n        .ibm-mainframe-datathon-container .theme-section-heading {\n            font-size: 18px !important;\n            font-family: var(--font-stack);\n        }\n\n        .ibm-mainframe-datathon-container .badge-pill,\n        .ibm-mainframe-datathon-container .hero-description,\n        .ibm-mainframe-datathon-container .about-text-block p,\n        .ibm-mainframe-datathon-container .theme-pointer-text,\n        .ibm-mainframe-datathon-container .metric-lbl,\n        .ibm-mainframe-datathon-container .hub-pill,\n        .ibm-mainframe-datathon-container .interactive-card-text,\n        .ibm-mainframe-datathon-container .brand-txt,\n        .ibm-mainframe-datathon-container .eligibility-text {\n            font-size: 16px !important;\n            font-family: var(--font-stack);\n        }\n\n        /* --- Master Container Width Alignment --- */\n        .ibm-mainframe-datathon-container .dashboard-grid {\n            max-width: 1200px;\n            width: 100%;\n            display: grid;\n            grid-template-columns: repeat(12, 1fr);\n            gap: 16px;\n        }\n\n        /* --- Full Width Header Card --- */\n        .ibm-mainframe-datathon-container .hero-banner-card {\n            grid-column: span 12;\n            background: var(--ibm-white);\n            border: 1px solid var(--ibm-gray-20);\n            padding: 30px;\n            position: relative;\n            overflow: hidden;\n            box-shadow: 0 4px 16px rgba(0,0,0,0.02);\n        }\n\n        .ibm-mainframe-datathon-container .hero-banner-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            width: 300px;\n            height: 100%;\n            background: radial-gradient(circle at top right, rgba(15, 98, 254, 0.06), transparent 70%);\n            pointer-events: none;\n        }\n\n        .ibm-mainframe-datathon-container .badge-pill {\n            background: rgba(15, 98, 254, 0.08);\n            color: var(--ibm-blue-60);\n            font-weight: 600;\n            padding: 4px 10px;\n            letter-spacing: 0.5px;\n            text-transform: uppercase;\n            display: inline-block;\n            margin-bottom: 12px;\n        }\n\n        .ibm-mainframe-datathon-container .hero-title {\n            font-weight: 300;\n            color: var(--ibm-gray-100);\n            line-height: 1.3;\n            margin-bottom: 12px;\n            letter-spacing: -0.5px;\n        }\n\n        .ibm-mainframe-datathon-container .hero-title strong {\n            font-weight: 700;\n            color: var(--ibm-blue-60);\n        }\n\n        .ibm-mainframe-datathon-container .hero-description {\n            line-height: 1.5;\n            color: var(--ibm-gray-70);\n            max-width: 850px;\n        }\n\n        /* --- Refactored Curved Box Headers --- */\n        .ibm-mainframe-datathon-container .block-section-title {\n            grid-column: span 12;\n            font-weight: 700;\n            margin-top: 24px;\n            padding: 10px 24px;\n            border-radius: 30px; \n            width: fit-content; \n            display: inline-flex;\n            align-items: center;\n        }\n\n        .ibm-mainframe-datathon-container .box-why {\n            background-color: rgba(138, 63, 252, 0.1);\n            color: var(--ibm-purple-60) !important;\n            border: 1px solid rgba(138, 63, 252, 0.3);\n        }\n\n        .ibm-mainframe-datathon-container .box-who {\n            background-color: rgba(15, 98, 254, 0.08);\n            color: var(--ibm-blue-60) !important;\n            border: 1px solid rgba(15, 98, 254, 0.25);\n        }\n\n        /* --- Mainframe Specs and General Info Block --- */\n        .ibm-mainframe-datathon-container .about-text-block {\n            grid-column: span 7;\n            background: var(--ibm-white);\n            border: 1px solid var(--ibm-gray-20);\n            padding: 24px;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            gap: 16px;\n        }\n\n        .ibm-mainframe-datathon-container .about-text-block p {\n            color: var(--ibm-gray-70);\n            line-height: 1.5;\n        }\n\n        /* --- Integrated Structured Theme Micro-Console --- */\n        .ibm-mainframe-datathon-container .theme-console-wrapper {\n            display: flex;\n            flex-direction: column;\n            gap: 8px;\n            width: 100%;\n            border-top: 1px solid var(--ibm-gray-20);\n            padding-top: 16px;\n        }\n\n        .ibm-mainframe-datathon-container .theme-section-heading {\n            font-weight: 700;\n            color: var(--ibm-gray-100);\n            margin-bottom: 4px;\n        }\n\n        .ibm-mainframe-datathon-container .theme-pointer-row {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            background: var(--ibm-gray-10);\n            border: 1px solid var(--ibm-gray-20);\n            border-left: 3px solid var(--ibm-blue-60);\n            padding: 10px 14px;\n            transition: var(--transition-main);\n            cursor: pointer;\n        }\n\n        .ibm-mainframe-datathon-container .theme-pointer-row:hover {\n            background: var(--ibm-white);\n            border-color: var(--ibm-blue-60);\n            transform: translateX(4px);\n            box-shadow: 0 4px 12px rgba(15, 98, 254, 0.05);\n        }\n\n        .ibm-mainframe-datathon-container .theme-vector-icon {\n            width: 22px;\n            height: 22px;\n            fill: none;\n            stroke: var(--ibm-gray-70);\n            stroke-width: 2.2;\n            stroke-linecap: round;\n            stroke-linejoin: round;\n            flex-shrink: 0;\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .theme-pointer-row:hover .theme-vector-icon {\n            stroke: var(--ibm-blue-60);\n            transform: scale(1.05);\n        }\n\n        .ibm-mainframe-datathon-container .theme-pointer-text {\n            font-weight: 600;\n            color: var(--ibm-gray-100);\n            line-height: 1.3;\n        }\n\n        /* --- Metrics Core Blocks --- */\n        .ibm-mainframe-datathon-container .metrics-grid-block {\n            grid-column: span 5;\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 12px;\n        }\n\n        .ibm-mainframe-datathon-container .metric-micro-card {\n            background: var(--ibm-gray-10);\n            border: 1px solid var(--ibm-gray-20);\n            padding: 16px;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center; \n            text-align: center;\n            position: relative;\n            cursor: pointer;\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .metric-micro-card:hover {\n            background: var(--ibm-white);\n            border-color: var(--ibm-blue-60);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(0,0,0,0.05);\n        }\n\n        .ibm-mainframe-datathon-container .metric-micro-card::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 3px;\n            background-color: var(--ibm-blue-60);\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .metric-micro-card:hover::after {\n            width: 100%;\n        }\n\n        .ibm-mainframe-datathon-container .metric-val {\n            font-weight: 700;\n            color: var(--ibm-gray-100);\n            line-height: 1.2;\n            margin-bottom: 4px;\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .metric-micro-card:nth-child(1) .metric-val { color: var(--ibm-teal-50); }\n        .ibm-mainframe-datathon-container .metric-micro-card:nth-child(3) .metric-val { color: var(--ibm-magenta-60); }\n\n        .ibm-mainframe-datathon-container .metric-lbl {\n            font-weight: 600;\n            text-transform: uppercase;\n            color: var(--ibm-gray-70);\n            letter-spacing: 0.5px;\n        }\n\n        .ibm-mainframe-datathon-container .metric-span-2 {\n            grid-column: span 2;\n            align-items: center;\n        }\n\n        .ibm-mainframe-datathon-container .hub-micro-badges-row {\n            display: flex;\n            gap: 6px;\n            flex-direction: column;\n            align-items: center; \n            width: 100%;\n            margin-top: 8px;\n        }\n\n        .ibm-mainframe-datathon-container .hub-pill {\n            background: var(--ibm-white);\n            padding: 6px 12px;\n            font-weight: 400;\n            color: var(--ibm-gray-100);\n            border: 1px solid var(--ibm-gray-20);\n            transition: var(--transition-main);\n            display: inline-flex;\n            align-items: center;\n            justify-content: center; \n            gap: 8px;\n            width: fit-content;\n        }\n\n        .ibm-mainframe-datathon-container .node-icon-graphic {\n            width: 14px;\n            height: 14px;\n            fill: none;\n            stroke: var(--ibm-blue-60);\n            stroke-width: 2;\n            stroke-linecap: round;\n            stroke-linejoin: round;\n            flex-shrink: 0;\n        }\n\n        .ibm-mainframe-datathon-container .metric-span-2:hover .hub-pill {\n            background: var(--ibm-gray-10);\n            border-color: var(--ibm-gray-30);\n        }\n\n        /* --- SECTION A: Why Participate (Dynamic Bento Grid) --- */\n        .ibm-mainframe-datathon-container .benefit-interactive-card {\n            grid-column: span 4;\n            background: var(--ibm-white);\n            border: 1px solid var(--ibm-gray-20);\n            padding: 24px;\n            min-height: 180px;\n            position: relative;\n            overflow: hidden;\n            cursor: pointer;\n            transition: var(--transition-main);\n            display: flex;\n            flex-direction: column;\n            justify-content: flex-start;\n        }\n\n        .ibm-mainframe-datathon-container .card-span-6 {\n            grid-column: span 6;\n        }\n\n        .ibm-mainframe-datathon-container .benefit-interactive-card:hover {\n            transform: translateY(-4px);\n            background: var(--ibm-white);\n        }\n\n        .ibm-mainframe-datathon-container .benefit-interactive-card-content {\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n        }\n\n        .ibm-mainframe-datathon-container .interactive-heading-wrapper {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            margin-bottom: 8px;\n        }\n\n        .ibm-mainframe-datathon-container .interactive-card-heading {\n            font-weight: 700;\n            color: var(--ibm-gray-100);\n            line-height: 1.3;\n        }\n\n        .ibm-mainframe-datathon-container .interactive-card-text {\n            color: var(--ibm-gray-70);\n            line-height: 1.5;\n        }\n\n        .ibm-mainframe-datathon-container .card-vector {\n            width: 18px;\n            height: 18px;\n            fill: none;\n            stroke-width: 2.2;\n            stroke-linecap: round;\n            stroke-linejoin: round;\n            flex-shrink: 0;\n        }\n        \n        .ibm-mainframe-datathon-container .theme-blue .card-vector { stroke: var(--ibm-blue-60); }\n        .ibm-mainframe-datathon-container .theme-teal .card-vector { stroke: var(--ibm-teal-50); }\n        .ibm-mainframe-datathon-container .theme-purple .card-vector { stroke: var(--ibm-purple-60); }\n        .ibm-mainframe-datathon-container .theme-magenta .card-vector { stroke: var(--ibm-magenta-60); }\n\n        .ibm-mainframe-datathon-container .theme-blue { border-top: 3px solid var(--ibm-blue-60); }\n        .ibm-mainframe-datathon-container .theme-blue:hover { box-shadow: 0 10px 24px rgba(15, 98, 254, 0.15); }\n\n        .ibm-mainframe-datathon-container .theme-teal { border-top: 3px solid var(--ibm-teal-50); }\n        .ibm-mainframe-datathon-container .theme-teal:hover { box-shadow: 0 10px 24px rgba(0, 125, 121, 0.15); }\n\n        .ibm-mainframe-datathon-container .theme-purple { border-top: 3px solid var(--ibm-purple-60); }\n        .ibm-mainframe-datathon-container .theme-purple:hover { box-shadow: 0 10px 24px rgba(138, 63, 252, 0.15); }\n\n        .ibm-mainframe-datathon-container .theme-magenta { border-top: 3px solid var(--ibm-magenta-60); }\n        .ibm-mainframe-datathon-container .theme-magenta:hover { box-shadow: 0 10px 24px rgba(209, 39, 113, 0.15); }\n\n\n        /* --- SECTION B: Who Can Participate (Terminal Console Matrix) --- */\n        .ibm-mainframe-datathon-container .slate-container-block {\n            grid-column: span 12;\n            display: flex;\n            flex-direction: column;\n            gap: 1px;\n            background: var(--ibm-gray-20);\n            border: 1px solid var(--ibm-gray-20);\n            margin-top: 12px;\n        }\n\n        .ibm-mainframe-datathon-container .slate-row {\n            background: var(--ibm-white);\n            padding: 20px 24px;\n            display: grid;\n            grid-template-columns: 4fr 8fr;\n            gap: 24px;\n            align-items: start;\n            position: relative;\n            cursor: pointer;\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .slate-row::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 0;\n            background-color: var(--ibm-blue-60);\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .slate-row:hover {\n            background-color: #f1f5fe;\n            padding-left: 28px;\n        }\n\n        .ibm-mainframe-datathon-container .slate-row:hover::before {\n            width: 5px;\n        }\n\n        .ibm-mainframe-datathon-container .gate-track:hover::before {\n            background-color: var(--ibm-teal-50);\n        }\n\n        .ibm-mainframe-datathon-container .slate-heading-wrapper {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .ibm-mainframe-datathon-container .profile-banner-heading {\n            font-weight: 700;\n            color: var(--ibm-gray-100);\n            line-height: 1.3;\n        }\n\n        .ibm-mainframe-datathon-container .slate-vector {\n            width: 16px;\n            height: 16px;\n            fill: none;\n            stroke: var(--ibm-gray-70);\n            stroke-width: 2.2;\n            stroke-linecap: round;\n            stroke-linejoin: round;\n            transition: var(--transition-main);\n        }\n\n        .ibm-mainframe-datathon-container .slate-row:hover .slate-vector {\n            stroke: var(--ibm-blue-60);\n        }\n\n        .ibm-mainframe-datathon-container .gate-track:hover .slate-vector {\n            stroke: var(--ibm-teal-50);\n        }\n\n        .ibm-mainframe-datathon-container .eligibility-text {\n            color: var(--ibm-gray-70);\n            line-height: 1.5;\n        }\n\n        /* --- Footer Brand Stripe --- */\n        .ibm-mainframe-datathon-container .brand-footer-bar {\n            grid-column: span 12;\n            background: var(--ibm-gray-10);\n            border: 1px solid var(--ibm-gray-20);\n            padding: 16px 24px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-top: 20px;\n        }\n\n        .ibm-mainframe-datathon-container .brand-txt {\n            font-weight: 400;\n            color: var(--ibm-gray-70);\n        }\n\n        .ibm-mainframe-datathon-container .brand-txt strong {\n            color: var(--ibm-gray-100);\n            font-weight: 700;\n        }\n\n        /* --- Responsiveness System --- */\n        @media(max-width: 992px) {\n            .ibm-mainframe-datathon-container .about-text-block,\n            .ibm-mainframe-datathon-container .metrics-grid-block {\n                grid-column: span 12;\n            }\n            .ibm-mainframe-datathon-container .benefit-interactive-card {\n                grid-column: span 6;\n            }\n            .ibm-mainframe-datathon-container .slate-row {\n                grid-template-columns: 1fr;\n                gap: 8px;\n                padding: 16px;\n            }\n        }\n\n        @media(max-width: 680px) {\n            .ibm-mainframe-datathon-container .benefit-interactive-card,\n            .ibm-mainframe-datathon-container .card-span-6 {\n                grid-column: span 12;\n            }\n            .ibm-mainframe-datathon-container .hero-banner-card {\n                padding: 20px;\n            }\n            .ibm-mainframe-datathon-container .brand-footer-bar {\n                flex-direction: column;\n                gap: 8px;\n                text-align: center;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"ibm-mainframe-datathon-container\">\n        \n        <div class=\"dashboard-grid\">\n            \n            <header class=\"hero-banner-card\">\n                <span class=\"badge-pill\">One of the  world's largest enterprise computing Datathons is back</span>\n                <h2 class=\"hero-title\">IBM Z <strong>Datathon 2026</strong></h2>\n                <p class=\"hero-description\">\n                    A global 24-hour hybrid hackathon built intentionally for college students who want to build real, scalable systems solutions on enterprise-grade IBM Z architecture.\n                </p>\n            </header>\n\n            <section class=\"about-text-block\">\n                <div>\n                    <p>\n                        Participants will build solutions that run on IBM Z / LinuxONE — one of the world's most secure, scalable, and powerful computing platforms — and present them to a panel of industry experts and IBM leaders.\n                    </p>\n                </div>\n                \n                <div class=\"theme-console-wrapper\">\n                    <h3 class=\"theme-section-heading\">Datathon Themes</h3>\n                    \n                    <div class=\"theme-pointer-row\">\n                        <svg class=\"theme-vector-icon\" viewBox=\"0 0 100 100\">\n                            <circle cx=\"50\" cy=\"32\" r=\"18\" fill=\"none\" stroke-width=\"5\"/>\n                            <path d=\"M22 75 C 22 55, 78 55, 78 75\" fill=\"none\" stroke-width=\"5\"/>\n                            <rect x=\"18\" y=\"58\" width=\"64\" height=\"34\" fill=\"#fafafa\" stroke-width=\"5\"/>\n                            <circle cx=\"36\" cy=\"74\" r=\"4\" fill=\"none\" stroke-width=\"4\"/>\n                            <circle cx=\"50\" cy=\"66\" r=\"4\" fill=\"none\" stroke-width=\"4\"/>\n                            <circle cx=\"68\" cy=\"74\" r=\"4\" fill=\"none\" stroke-width=\"4\"/>\n                            <circle cx=\"50\" cy=\"82\" r=\"4\" fill=\"none\" stroke-width=\"4\"/>\n                            <line x1=\"40\" y1=\"73\" x2=\"46\" y2=\"67\" stroke-width=\"4\"/>\n                            <line x1=\"54\" y1=\"68\" x2=\"64\" y2=\"73\" stroke-width=\"4\"/>\n                        </svg>\n                        <span class=\"theme-pointer-text\">Real-Time AI for Critical Decisions</span>\n                    </div>\n\n                    <div class=\"theme-pointer-row\">\n                        <svg class=\"theme-vector-icon\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/><circle cx=\"12\" cy=\"16\" r=\"1\"/></svg>\n                        <span class=\"theme-pointer-text\">AI Secured: Innovation Without Exposure</span>\n                    </div>\n\n                    <div class=\"theme-pointer-row\">\n                        <svg class=\"theme-vector-icon\" viewBox=\"0 0 24 24\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg>\n                        <span class=\"theme-pointer-text\">Wildcard: Beyond the Obvious</span>\n                    </div>\n                </div>\n            </section>\n\n            <section class=\"metrics-grid-block\">\n                \n                <div class=\"metric-micro-card\">\n                    <span class=\"metric-lbl\">Prize Pool</span>\n                    <span class=\"metric-val\">$50K+</span>\n                </div>\n\n                <div class=\"metric-micro-card\">\n                    <span class=\"metric-lbl\">Event Dates</span>\n                    <span class=\"metric-val\">Oct 17–18</span>\n                </div>\n\n                <div class=\"metric-micro-card\">\n                    <span class=\"metric-lbl\">Deadline</span>\n                    <span class=\"metric-val\">Oct 1</span>\n                </div>\n\n                <div class=\"metric-micro-card\">\n                    <span class=\"metric-lbl\">Format</span>\n                    <span class=\"metric-val\">Global</span>\n                </div>\n\n                <div class=\"metric-micro-card metric-span-2\">\n                    <span class=\"metric-lbl\">Participation Model</span>\n                    <div class=\"hub-micro-badges-row\">\n                        <span class=\"hub-pill\">\n                            <svg class=\"node-icon-graphic\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20\"/></svg>\n                            8 In-Person Hubs Worldwide\n                        </span>\n                        <span class=\"hub-pill\">\n                            <svg class=\"node-icon-graphic\" viewBox=\"0 0 24 24\"><path d=\"M18 10a6 6 0 0 0-12 0c0 7 6 11 6 11s6-4 6-11z\"/></svg>\n                            Virtual Participation Across Globe\n                        </span>\n                    </div>\n                </div>\n\n            </section>\n\n            <h2 class=\"block-section-title box-why\">Why Participate?</h2>\n\n            <div class=\"benefit-interactive-card theme-blue\">\n                <div class=\"benefit-interactive-card-content\">\n                    <div class=\"interactive-heading-wrapper\">\n                        <svg class=\"card-vector\" viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><polyline points=\"9 11 11 13 15 9\"/></svg>\n                        <h4 class=\"interactive-card-heading\">Credentials That Matter</h4>\n                    </div>\n                    <p class=\"interactive-card-text\">Earn exclusive IBM digital badges and industry-recognized certifications to fast-track your profile validation.</p>\n                </div>\n            </div>\n\n            <div class=\"benefit-interactive-card theme-teal\">\n                <div class=\"benefit-interactive-card-content\">\n                    <div class=\"interactive-heading-wrapper\">\n                        <svg class=\"card-vector\" viewBox=\"0 0 24 24\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n                        <h4 class=\"interactive-card-heading\">$50K+ Active Stakes</h4>\n                    </div>\n                    <p class=\"interactive-card-text\">Win from a massive global prize pool distributed across specialized online and physical local hub tracks.</p>\n                </div>\n            </div>\n\n            <div class=\"benefit-interactive-card theme-purple\">\n                <div class=\"benefit-interactive-card-content\">\n                    <div class=\"interactive-heading-wrapper\">\n                        <svg class=\"card-vector\" viewBox=\"0 0 24 24\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n                        <h4 class=\"interactive-card-heading\">Elite Networking Space</h4>\n                    </div>\n                    <p class=\"interactive-card-text\">Connect and network closely with active IBM engineers, global technical subject matter experts (SMEs), and competitive peers.</p>\n                </div>\n            </div>\n\n            <div class=\"benefit-interactive-card card-span-6 theme-magenta\">\n                <div class=\"benefit-interactive-card-content\">\n                    <div class=\"interactive-heading-wrapper\">\n                        <svg class=\"card-vector\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"/><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"/><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"/><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"/></svg>\n                        <h4 class=\"interactive-card-heading\">Enterprise Computing Exposure</h4>\n                    </div>\n                    <p class=\"interactive-card-text\">Get unique, direct hands-on operational access with real enterprise mainframe technology via IBM Z systems environments.</p>\n                </div>\n            </div>\n\n            <div class=\"benefit-interactive-card card-span-6 theme-blue\">\n                <div class=\"benefit-interactive-card-content\">\n                    <div class=\"interactive-heading-wrapper\">\n                        <svg class=\"card-vector\" viewBox=\"0 0 24 24\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"/><polyline points=\"2 17 12 22 22 17\"/><polyline points=\"2 12 12 17 22 12\"/></svg>\n                        <h4 class=\"interactive-card-heading\">Pitch Executive Leadership</h4>\n                    </div>\n                    <p class=\"interactive-card-text\">Pitch your functional software architecture models straight to industry leaders and corporate decision makers to escalate your career path.</p>\n                </div>\n            </div>\n\n\n            <h2 class=\"block-section-title box-who\">Who Can Participate?</h2>\n\n            <div class=\"slate-container-block\">\n                \n                <div class=\"slate-row\">\n                    <div class=\"slate-heading-wrapper\">\n                        <svg class=\"slate-vector\" viewBox=\"0 0 24 24\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"/><path d=\"M6 12v5c0 2 3 3 6 3s6-1 6-3v-5\"/></svg>\n                        <h4 class=\"profile-banner-heading\">College Students Worldwide</h4>\n                    </div>\n                    <p class=\"eligibility-text\">Open to current undergraduate or graduate student cohorts registered across any institution globally.</p>\n                </div>\n\n                <div class=\"slate-row\">\n                    <div class=\"slate-heading-wrapper\">\n                        <svg class=\"slate-vector\" viewBox=\"0 0 24 24\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>\n                        <h4 class=\"profile-banner-heading\">Online (Global) Access</h4>\n                    </div>\n                    <p class=\"eligibility-text\">Complete integration paths open for developers participating remotely from any timezone globally.</p>\n                </div>\n\n                <div class=\"slate-row\">\n                    <div class=\"slate-heading-wrapper\">\n                        <svg class=\"slate-vector\" viewBox=\"0 0 24 24\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n                        <h4 class=\"profile-banner-heading\">8 Physical Node Hubs</h4>\n                    </div>\n                    <p class=\"eligibility-text\">On-site infrastructure hubs open across targeted global metropolitan regions for physical workspace support.</p>\n                </div>\n\n                <div class=\"slate-row gate-track\">\n                    <div class=\"slate-heading-wrapper\">\n                        <svg class=\"slate-vector\" style=\"stroke: var(--ibm-teal-50);\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>\n                        <h4 class=\"profile-banner-heading\" style=\"color: var(--ibm-teal-50);\">Free Registration Gate</h4>\n                    </div>\n                    <p class=\"eligibility-text\">Zero cost entry requirements. Complete availability to foundational server tools and computational platforms for all selected innovators.</p>\n                </div>\n\n            </div>\n\n            <footer class=\"brand-footer-bar\">\n                <span class=\"brand-txt\">Powered by <strong>IBM</strong></span>\n                <span class=\"brand-txt\">Organised by <strong>Shooting Stars Foundation</strong></span>\n            </footer>\n\n        </div>\n\n    </div>\n\n</body>\n</html>",
