# Optional. Without these the site runs exactly as it does today, with the sign-in button hidden
# and favourites stored in the browser only. That is the normal state for a contributor.
#
# Both values are PUBLIC BY DESIGN: the anon key is meant to ship in a browser bundle, and the
# database's row level security policies are what actually protect user data.
#
# Supabase → Project Settings → API Keys → the key labelled `anon` `public`.
# Supabase → Authentication → URL Configuration must allow both callback roots:
#   http://localhost:5173/
#   https://shipitdev.github.io/hackawon/
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NEVER put these in this file or anywhere in the repo:
#   - the service_role key (bypasses every security policy)
#   - the Postgres connection string or database password
